+<?php
+
+declare(strict_types=1);
+
+namespace MathPHP\Tests\Algebra;
+
+use MathPHP\Algebra;
+use PHPUnit\Framework\Attributes\DataProvider;
+
+class AreCoprimeTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @test  Coprimality is independent of operand order and emits no diagnostics.
+     * @param int  $a
+     * @param int  $b
+     * @param bool $expected
+     */
+    #[DataProvider('dataProviderForAreCoprime')]
+    public function testAreCoprime(int $a, int $b, bool $expected): void
+    {
+        // Given
+        \set_error_handler(static function (int $severity, string $message, string $file, int $line): never {
+            throw new \ErrorException($message, 0, $severity, $file, $line);
+        }, \E_ALL);
+
+        // When
+        try {
+            $result   = Algebra::areCoprime($a, $b);
+            $reversed = Algebra::areCoprime($b, $a);
+        } finally {
+            \restore_error_handler();
+        }
+
+        // Then
+        $this->assertSame($expected, $result);
+        $this->assertSame($expected, $reversed);
+    }
+
+    /**
+     * @return array<string, array{int, int, bool}>
+     */
+    public static function dataProviderForAreCoprime(): array
+    {
+        $pairs = [
+            'coprime' => [35, 64, true],
+            'common factor' => [12, 18, false],
+            'one divides other' => [6, 48, false],
+            'equal nonunits' => [17, 17, false],
+            'unit pair' => [1, 1, true],
+            'unit and nonunit' => [1, 18, true],
+        ];
+        $cases = [];
+        foreach ($pairs as $name => [$a, $b, $expected]) {
+            $cases[$name . ' positive']       = [$a, $b, $expected];
+            $cases[$name . ' negative']       = [-$a, -$b, $expected];
+            $cases[$name . ' negative first'] = [-$a, $b, $expected];
+            $cases[$name . ' negative last']  = [$a, -$b, $expected];
+        }
+
+        return $cases + [
+            'zero and one' => [0, 1, true],
+            'zero and negative one' => [0, -1, true],
+            'both zero' => [0, 0, false],
+            'zero and two' => [0, 2, false],
+            'zero and negative two' => [0, -2, false],
+            'zero and max' => [0, \PHP_INT_MAX, false],
+            'zero and negative max' => [0, -\PHP_INT_MAX, false],
+            'min and zero' => [\PHP_INT_MIN, 0, false],
+            'both min' => [\PHP_INT_MIN, \PHP_INT_MIN, false],
+            'min and two' => [\PHP_INT_MIN, 2, false],
+            'min and negative two' => [\PHP_INT_MIN, -2, false],
+            'min and one' => [\PHP_INT_MIN, 1, true],
+            'min and negative one' => [\PHP_INT_MIN, -1, true],
+            'min and max' => [\PHP_INT_MIN, \PHP_INT_MAX, true],
+            'min and negative max' => [\PHP_INT_MIN, -\PHP_INT_MAX, true],
+            'min and three' => [\PHP_INT_MIN, 3, true],
+            'min and negative three' => [\PHP_INT_MIN, -3, true],
+            'both max' => [\PHP_INT_MAX, \PHP_INT_MAX, false],
+            'max and negative max' => [\PHP_INT_MAX, -\PHP_INT_MAX, false],
+            'max and preceding integer' => [\PHP_INT_MAX, \PHP_INT_MAX - 1, true],
+            'min plus one and two' => [\PHP_INT_MIN + 1, 2, true],
+        ];
+    }
+}
