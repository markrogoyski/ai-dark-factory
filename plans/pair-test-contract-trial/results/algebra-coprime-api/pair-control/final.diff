+    /**
+     * Whether two integers are coprime: their nonnegative mathematical gcd is one.
+     * Signs and operand order do not affect the result. Zero is coprime only to 1 or -1;
+     * (0, 0) is not coprime.
+     *
+     * Supports all native signed integers, including PHP_INT_MIN, without overflow.
+     * Euclid's algorithm runs on signed operands and compares the terminal value with
+     * the two units, so the positive magnitude of PHP_INT_MIN never needs to be represented.
+     *
+     * @param  int $a
+     * @param  int $b
+     *
+     * @return bool True if the mathematical gcd is one
+     */
+    public static function areCoprime(int $a, int $b): bool
+    {
+        while ($b !== 0) {
+            // A unit divisor establishes coprimality without evaluating PHP_INT_MIN % -1.
+            if ($b === 1 || $b === -1) {
+                return true;
+            }
+            $r = $a % $b;
+            $a = $b;
+            $b = $r;
+        }
+
+        return $a === 1 || $a === -1;
+    }
