+<?php
+
+declare(strict_types=1);
+
+namespace MathPHP\Tests\Algebra;
+
+use MathPHP\Algebra;
+use PHPUnit\Framework\Attributes\DataProvider;
+
+class AreCoprimeTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @test Coprimality is invariant under sign changes and operand swaps.
+     * @param int  $a
+     * @param int  $b
+     * @param bool $expected
+     */
+    #[DataProvider('dataProviderForSignAndOrderInvariance')]
+    public function testAreCoprimeSignAndOrderInvariance(int $a, int $b, bool $expected): void
+    {
+        foreach ([1, -1] as $a_sign) {
+            foreach ([1, -1] as $b_sign) {
+                $this->assertCoprimeInBothOrders($a_sign * $a, $b_sign * $b, $expected);
+            }
+        }
+    }
+
+    /**
+     * Expectations follow from prime factors, units, and consecutive integers being coprime.
+     * @return array<string, array{int, int, bool}>
+     */
+    public static function dataProviderForSignAndOrderInvariance(): array
+    {
+        return [
+            'coprime composites' => [8, 15, true],
+            'shared factor' => [8, 12, false],
+            'distinct prime factors' => [35, 64, true],
+            'equal nonunits' => [7, 7, false],
+            'two units' => [1, 1, true],
+            'unit and nonunit' => [1, 12, true],
+            'consecutive integers near maximum' => [\PHP_INT_MAX, \PHP_INT_MAX - 1, true],
+            'equal maximum integers' => [\PHP_INT_MAX, \PHP_INT_MAX, false],
+        ];
+    }
+
+    /**
+     * @test Zero is coprime only to a unit, in either operand order.
+     * @param int  $partner
+     * @param bool $expected
+     */
+    #[DataProvider('dataProviderForZero')]
+    public function testAreCoprimeWithZero(int $partner, bool $expected): void
+    {
+        $this->assertCoprimeInBothOrders(0, $partner, $expected);
+    }
+
+    /**
+     * Mathematical oracle: gcd(0, n) = |n|, including gcd(0, 0) = 0.
+     * @return array<string, array{int, bool}>
+     */
+    public static function dataProviderForZero(): array
+    {
+        return [
+            'zero' => [0, false],
+            'positive unit' => [1, true],
+            'negative unit' => [-1, true],
+            'two' => [2, false],
+            'negative two' => [-2, false],
+            'eight' => [8, false],
+            'negative eight' => [-8, false],
+            'maximum integer' => [\PHP_INT_MAX, false],
+            'negative maximum integer' => [-\PHP_INT_MAX, false],
+            'minimum integer' => [\PHP_INT_MIN, false],
+        ];
+    }
+
+    /**
+     * @test The most negative integer is supported without warnings or exceptions.
+     * @param int  $partner
+     * @param bool $expected
+     */
+    #[DataProvider('dataProviderForMostNegativeInteger')]
+    public function testAreCoprimeWithMostNegativeInteger(int $partner, bool $expected): void
+    {
+        $this->assertCoprimeInBothOrders(\PHP_INT_MIN, $partner, $expected);
+    }
+
+    /**
+     * Mathematical oracle: |PHP_INT_MIN| is a power of two, coprime exactly to odd integers.
+     * @return array<string, array{int, bool}>
+     */
+    public static function dataProviderForMostNegativeInteger(): array
+    {
+        return [
+            'minimum integer' => [\PHP_INT_MIN, false],
+            'zero' => [0, false],
+            'two' => [2, false],
+            'negative two' => [-2, false],
+            'six' => [6, false],
+            'negative six' => [-6, false],
+            'positive unit' => [1, true],
+            'negative unit' => [-1, true],
+            'three' => [3, true],
+            'seven' => [7, true],
+            'negative seven' => [-7, true],
+            'maximum integer' => [\PHP_INT_MAX, true],
+            'negative maximum integer' => [-\PHP_INT_MAX, true],
+            'minimum plus one' => [\PHP_INT_MIN + 1, true],
+        ];
+    }
+
+    /**
+     * Make warnings fail independently of PHPUnit's warning policy, restoring its handler afterward.
+     */
+    private function assertCoprimeInBothOrders(int $a, int $b, bool $expected): void
+    {
+        \set_error_handler(static function (int $severity, string $message, string $file, int $line): never {
+            throw new \ErrorException($message, 0, $severity, $file, $line);
+        }, \E_ALL);
+
+        try {
+            // When
+            $forward = Algebra::areCoprime($a, $b);
+            $reverse = Algebra::areCoprime($b, $a);
+        } finally {
+            \restore_error_handler();
+        }
+
+        // Then
+        $this->assertSame($expected, $forward, "areCoprime($a, $b)");
+        $this->assertSame($expected, $reverse, "areCoprime($b, $a)");
+    }
+}
