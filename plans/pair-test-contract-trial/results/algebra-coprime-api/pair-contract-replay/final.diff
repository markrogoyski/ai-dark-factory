+    /**
+     * Whether two integers are coprime: their nonnegative mathematical gcd is one.
+     * Signs and operand order do not affect the result. Zero is coprime only to 1 or -1;
+     * (0, 0) is not coprime.
+     *
+     * Uses Euclid's algorithm on signed operands without taking absolute values, so
+     * PHP_INT_MIN is supported even when the gcd magnitude cannot be represented as an int.
+     *
+     * @param  int $a
+     * @param  int $b
+     *
+     * @return bool
+     */
+    public static function areCoprime(int $a, int $b): bool
+    {
+        while ($b !== 0) {
+            // A unit divisor establishes coprimality without any further arithmetic.
+            if ($b === 1 || $b === -1) {
+                return true;
+            }
+            $r = $a % $b;
+            $a = $b;
+            $b = $r;
+        }
+
+        return $a === 1 || $a === -1;
+    }
