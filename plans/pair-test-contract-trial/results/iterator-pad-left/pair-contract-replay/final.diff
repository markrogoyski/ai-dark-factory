+++ b/tests/Single/PadLeftStreamingTest.php
@@ -0,0 +1,71 @@
+<?php
+
+declare(strict_types=1);
+
+namespace IterTools\Tests\Single;
+
+use IterTools\Single;
+
+class PadLeftStreamingTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @test         padLeft yields after bounded lookahead without advancing a suspended source
+     * @dataProvider dataProviderForStreaming
+     */
+    public function testBoundedLookaheadAndSuspension(int $length, bool $infinite): void
+    {
+        // Given a source that rejects every pull beyond the consumer's current budget
+        $initialLookahead = \max(1, $length);
+        $allowedPulls = $initialLookahead;
+        $pulled = [];
+        $source = (static function () use (&$allowedPulls, &$pulled, $infinite): \Generator {
+            for ($value = 0; $infinite || $value < PHP_INT_MAX; ++$value) {
+                if ($value >= $allowedPulls) {
+                    throw new \RuntimeException('Source requested beyond the permitted lookahead');
+                }
+                $pulled[] = $value;
+                yield "source-$value" => $value;
+            }
+        })();
+
+        // When
+        $output = Single::padLeft($source, $length, null);
+
+        // Then construction does not start the source
+        $this->assertSame([], $pulled);
+
+        // When the consumer requests the first output
+        $output->rewind();
+
+        // Then buffered output and the first two tail values obey the same pull boundary
+        for ($index = 0; $index < $initialLookahead + 2; ++$index) {
+            $expectedPulled = \range(0, \max($initialLookahead, $index + 1) - 1);
+            $this->assertSame($expectedPulled, $pulled);
+
+            // Repeated observations leave the output suspended without requesting another source value
+            for ($observation = 0; $observation < 2; ++$observation) {
+                $this->assertTrue($output->valid());
+                $this->assertSame($index, $output->key());
+                $this->assertSame($index, $output->current());
+                $this->assertSame($expectedPulled, $pulled);
+            }
+
+            if ($index + 1 < $initialLookahead + 2) {
+                $allowedPulls = \max($initialLookahead, $index + 2);
+                $output->next();
+            }
+        }
+    }
+
+    public static function dataProviderForStreaming(): array
+    {
+        return [
+            'zero infinite' => [0, true],
+            'one infinite' => [1, true],
+            'three infinite' => [3, true],
+            'zero long finite' => [0, false],
+            'one long finite' => [1, false],
+            'three long finite' => [3, false],
+        ];
+    }
+}
