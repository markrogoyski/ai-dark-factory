@@ -0,0 +1,102 @@
+<?php
+
+declare(strict_types=1);
+
+namespace IterTools\Tests\Stream;
+
+use IterTools\Stream;
+
+class StreamPadLeftStreamingTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @test         Stream::padLeft preserves the bounded lookahead and suspended source position
+     * @dataProvider dataProviderForStreaming
+     */
+    public function testBoundedLookaheadAndSuspension(int $length, bool $infinite): void
+    {
+        // Given
+        $initialLookahead = \max(1, $length);
+        $allowedPulls = $initialLookahead;
+        $pulled = [];
+        $source = self::guardedSource($allowedPulls, $pulled, $infinite);
+
+        // When
+        $stream = Stream::of($source)->padLeft($length, null);
+        $output = $stream->getIterator();
+
+        // Then neither creating the pipeline nor obtaining its iterator consumes the source
+        $this->assertSame([], $pulled);
+
+        // When
+        $output->rewind();
+
+        // Then
+        for ($index = 0; $index < $initialLookahead + 2; ++$index) {
+            $expectedPulled = \range(0, \max($initialLookahead, $index + 1) - 1);
+            $this->assertSame($expectedPulled, $pulled);
+
+            for ($observation = 0; $observation < 2; ++$observation) {
+                $this->assertTrue($output->valid());
+                $this->assertSame($index, $output->key());
+                $this->assertSame($index, $output->current());
+                $this->assertSame($expectedPulled, $pulled);
+            }
+
+            if ($index + 1 < $initialLookahead + 2) {
+                $allowedPulls = \max($initialLookahead, $index + 2);
+                $output->next();
+            }
+        }
+    }
+
+    /**
+     * @test         Stream::padLeft composes with limit without consuming beyond the requested prefix
+     * @dataProvider dataProviderForStreaming
+     */
+    public function testLimitedPrefix(int $length, bool $infinite): void
+    {
+        // Given
+        $prefixLength = \max(1, $length) + 2;
+        $allowedPulls = $prefixLength;
+        $pulled = [];
+        $source = self::guardedSource($allowedPulls, $pulled, $infinite);
+        $stream = Stream::of($source)->padLeft($length, null)->limit($prefixLength);
+        $this->assertSame([], $pulled);
+
+        // When
+        $result = $stream->toArray();
+
+        // Then
+        $expected = \range(0, $prefixLength - 1);
+        $this->assertSame($expected, $result);
+        $this->assertSame($expected, $pulled);
+    }
+
+    public static function dataProviderForStreaming(): array
+    {
+        return [
+            'zero infinite' => [0, true],
+            'one infinite' => [1, true],
+            'three infinite' => [3, true],
+            'zero long finite' => [0, false],
+            'one long finite' => [1, false],
+            'three long finite' => [3, false],
+        ];
+    }
+
+    /**
+     * @param array<int> $pulled
+     *
+     * @return \Generator<string, int>
+     */
+    private static function guardedSource(int &$allowedPulls, array &$pulled, bool $infinite): \Generator
+    {
+        for ($value = 0; $infinite || $value < PHP_INT_MAX; ++$value) {
+            if ($value >= $allowedPulls) {
+                throw new \RuntimeException('Source requested beyond the permitted lookahead');
+            }
+            $pulled[] = $value;
+            yield "source-$value" => $value;
+        }
+    }
+}
