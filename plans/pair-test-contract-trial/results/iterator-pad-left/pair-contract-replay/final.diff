+            $this->assertSame('Length cannot be negative: -1', $exception->getMessage());
+        }
+        $this->assertSame([], $pulled);
+    }
+
+    /**
+     * @test padLeft rejects a negative length before obtaining an aggregate's iterator
+     */
+    public function testNegativeLengthDoesNotAcquireIterator(): void
+    {
+        // Given
+        $source = new CountingIteratorAggregateFixture([null, 1]);
+        $output = Single::padLeft($source, -1, null);
+        $this->assertSame(0, $source->getIteratorCallCount());
+
+        // When
+        try {
+            $output->rewind();
+            $this->fail('Expected negative length to fail when iteration begins');
+        } catch (\InvalidArgumentException $exception) {
+            // Then
+            $this->assertSame('Length cannot be negative: -1', $exception->getMessage());
+        }
+        $this->assertSame(0, $source->getIteratorCallCount());
+    }
+
+    /**
+     * @param array<mixed> $data
+     *
+     * @return iterable<mixed>
+     */
+    private static function keyedSource(array $data, string $form): iterable
+    {
+        return match ($form) {
+            'array' => $data,
+            'generator' => GeneratorFixture::getKeyValueGenerator($data),
+            'iterator' => new \ArrayIterator($data),
+            'aggregate' => new IteratorAggregateFixture($data),
+            default => throw new \LogicException("Unknown input form: $form"),
+        };
+    }
 }
