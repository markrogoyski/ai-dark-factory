+<?php
+
+declare(strict_types=1);
+
+namespace IterTools\Tests\Stream;
+
+use IterTools\Stream;
+use IterTools\Tests\Fixture\CountingIteratorAggregateFixture;
+use IterTools\Tests\Fixture\GeneratorFixture;
+use IterTools\Tests\Fixture\IteratorAggregateFixture;
+
+class StreamPadLeftTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @test         Stream::padLeft is fluent and preserves finite values with sequential keys
+     * @dataProvider dataProviderForFiniteSources
+     * @param array<mixed> $data
+     * @param array<mixed> $expected
+     */
+    public function testFluentPadding(
+        string $form,
+        array $data,
+        int $length,
+        mixed $fill,
+        array $expected
+    ): void {
+        // Given
+        $source = match ($form) {
+            'array' => $data,
+            'generator' => GeneratorFixture::getKeyValueGenerator($data),
+            'iterator' => new \ArrayIterator($data),
+            'aggregate' => new IteratorAggregateFixture($data),
+            default => throw new \LogicException("Unknown input form: $form"),
+        };
+        $stream = Stream::of($source);
+
+        // When
+        $returned = $stream->padLeft($length, $fill);
+
+        // Then direct iteration retains keys, exposing any key reset at the buffer boundary
+        $this->assertSame($stream, $returned);
+        $this->assertSame($expected, \iterator_to_array($stream));
+    }
+
+    public static function dataProviderForFiniteSources(): \Generator
+    {
+        $data = ['a' => null, 9 => false, 'z' => 0];
+        foreach (['array', 'generator', 'iterator', 'aggregate'] as $form) {
+            foreach ([null, 'x'] as $fill) {
+                $cases = [
+                    [[], 0, []],
+                    [[], 1, [$fill]],
+                    [[], 3, [$fill, $fill, $fill]],
+                    [$data, 0, [null, false, 0]],
+                    [$data, 1, [null, false, 0]],
+                    [$data, 3, [null, false, 0]],
+                    [$data, 5, [$fill, $fill, null, false, 0]],
+                ];
+                foreach ($cases as [$source, $length, $expected]) {
+                    yield [$form, $source, $length, $fill, $expected];
+                }
+            }
+        }
+    }
+
+    /**
+     * @test         Stream::padLeft defers execution and validation
+     * @dataProvider dataProviderForDeferredLengths
+     */
+    public function testDeferredExecutionAndValidation(int $length): void
+    {
+        // Given
+        $pulled = [];
+        $source = GeneratorFixture::getRecordingGenerator([null, false], $pulled);
+        $stream = Stream::of($source);
+
+        // When
+        $returned = $stream->padLeft($length, 'x');
+        $output = $stream->getIterator();
+
+        // Then
+        $this->assertSame($stream, $returned);
+        $this->assertSame([], $pulled);
+
+        // When
+        if ($length < 0) {
+            try {
+                $output->rewind();
+                $this->fail('Expected negative length to fail when iteration begins');
+            } catch (\InvalidArgumentException $exception) {
+                // Then
+                $this->assertSame('Length cannot be negative: -1', $exception->getMessage());
+            }
+            $this->assertSame([], $pulled);
+        } else {
+            $expected = $length === 3 ? ['x', null, false] : [null, false];
+            $this->assertSame($expected, \iterator_to_array($output));
+            $this->assertSame([null, false], $pulled);
+        }
+    }
+
+    /**
+     * @test         Stream::padLeft does not obtain an aggregate iterator before execution or validation
+     * @dataProvider dataProviderForDeferredLengths
+     */
+    public function testDeferredIteratorAcquisition(int $length): void
+    {
+        // Given
+        $source = new CountingIteratorAggregateFixture([null, false]);
+        $stream = Stream::of($source);
+
+        // When
+        $returned = $stream->padLeft($length, 'x');
+        $output = $stream->getIterator();
+
+        // Then
+        $this->assertSame($stream, $returned);
+        $this->assertSame(0, $source->getIteratorCallCount());
+
+        // When
+        if ($length < 0) {
+            try {
+                $output->rewind();
+                $this->fail('Expected negative length to fail when iteration begins');
+            } catch (\InvalidArgumentException $exception) {
+                // Then
+                $this->assertSame('Length cannot be negative: -1', $exception->getMessage());
+            }
+            $this->assertSame(0, $source->getIteratorCallCount());
+        } else {
+            $expected = $length === 3 ? ['x', null, false] : [null, false];
+            $this->assertSame($expected, \iterator_to_array($output));
+            $this->assertSame(1, $source->getIteratorCallCount());
+        }
+    }
+
+    public static function dataProviderForDeferredLengths(): array
+    {
+        return [[-1], [0], [1], [3]];
+    }
+}
