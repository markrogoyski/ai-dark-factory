+            new IteratorAggregateFixture($data),
+        ];
+
+        // When / Then preserve actual output keys when collecting
+        foreach ($sources as $source) {
+            $this->assertSame($expected, \iterator_to_array(Single::padLeft($source, $length, null)));
+        }
+    }
+
+    public static function dataProviderForKeyedSource(): array
