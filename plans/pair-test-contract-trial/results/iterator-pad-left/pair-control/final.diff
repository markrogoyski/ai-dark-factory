+    /**
+     * @test         padLeft advances only on consumer demand after bounded lookahead
+     * @dataProvider dataProviderForStreaming
+     */
+    public function testBoundedLookahead(int $length, ?int $size): void
+    {
+        // Given
+        $pulled = 0;
+        $allowed = \max(1, $length);
+        $source = $this->guardedSource($pulled, $allowed, $size);
+        $result = Single::padLeft($source, $length, null);
+        $this->assertSame(0, $pulled);
+
+        // When
+        $result->rewind();
+        for ($index = 0; $index < 6; ++$index) {
+            if ($index > 0) {
+                $allowed = \max(\max(1, $length), $index + 1);
+                $result->next();
+            }
+
+            // Then repeated inspection never resumes the source
+            for ($inspection = 0; $inspection < 2; ++$inspection) {
+                $this->assertTrue($result->valid());
+                $this->assertSame($index, $result->key());
+                $this->assertSame($index + 1, $result->current());
+                $this->assertSame(\max(\max(1, $length), $index + 1), $pulled);
+            }
+        }
+    }
+
+    /**
+     * @test         padLeft does not resume its source after an early consumer stop
+     * @dataProvider dataProviderForStreaming
+     */
+    public function testEarlyTermination(int $length, ?int $size): void
+    {
+        // Given
+        $pulled = 0;
+        $allowed = \max(1, $length);
+        $source = $this->guardedSource($pulled, $allowed, $size);
+        $result = Single::padLeft($source, $length, null);
+
+        // When
+        foreach ($result as $key => $value) {
+            $this->assertSame(0, $key);
+            $this->assertSame(1, $value);
+            break;
+        }
+
+        // Then the source remains suspended even when the output is released
+        $this->assertSame($allowed, $pulled);
+        unset($result);
+        $this->assertSame($allowed, $pulled);
+        $this->assertSame($allowed, $source->current());
+    }
+
+    public static function dataProviderForStreaming(): array
+    {
+        return [
+            'infinite, length zero' => [0, null],
+            'infinite, length one' => [1, null],
+            'infinite, length three' => [3, null],
+            'long, length zero' => [0, 1_000_000],
+            'long, length one' => [1, 1_000_000],
+            'long, length three' => [3, 1_000_000],
+        ];
+    }
+
+    /**
+     * @return \Generator<string, int>
+     */
+    private function guardedSource(int &$pulled, int &$allowed, ?int $size): \Generator
+    {
+        for ($value = 1; $size === null || $value <= $size; ++$value) {
+            if ($pulled >= $allowed) {
+                throw new \LogicException('Source advanced without consumer demand');
+            }
+            ++$pulled;
+            yield 'key' . $value => $value;
+        }
+    }
+
+    /**
