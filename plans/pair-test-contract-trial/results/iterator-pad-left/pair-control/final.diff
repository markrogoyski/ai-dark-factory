+            [1, [10, 20, 30, 40]],
+            [3, [10, 20, 30, 40]],
+            [4, [10, 20, 30, 40]],
+            [6, [null, null, 10, 20, 30, 40]],
         ];
     }
 
diff --git a/tests/Stream/StreamPadLeftTest.php b/tests/Stream/StreamPadLeftTest.php
new file mode 100644
index 0000000..d570d11
--- /dev/null
+++ b/tests/Stream/StreamPadLeftTest.php
@@ -0,0 +1,133 @@
+<?php
+
+declare(strict_types=1);
+
+namespace IterTools\Tests\Stream;
+
+use IterTools\Stream;
+use IterTools\Tests\Fixture\GeneratorFixture;
+
+class StreamPadLeftTest extends \PHPUnit\Framework\TestCase
+{
+    /**
+     * @test padLeft is fluent and defers source consumption
+     */
+    public function testFluentDeferredDelegation(): void
+    {
+        // Given
+        $pulled = [];
+        $stream = Stream::of(GeneratorFixture::getRecordingGenerator([1, 2], $pulled));
+
+        // When
+        $result = $stream->padLeft(4, 'x');
+
+        // Then
+        $this->assertSame($stream, $result);
+        $this->assertSame([], $pulled);
+        $this->assertSame(['x', 'x', 1, 2], $result->toArray());
+        $this->assertSame([1, 2], $pulled);
+    }
+
+    /**
+     * @test         padLeft preserves values, fill identity and sequential keys
+     * @dataProvider dataProviderForFiniteSources
+     * @param        array<mixed> $data
+     * @param        array<mixed> $expected
+     */
+    public function testFiniteSources(array $data, int $length, mixed $fill, array $expected): void
+    {
+        // Given
+        $stream = Stream::of(GeneratorFixture::getKeyValueGenerator($data));
+
+        // When / Then collect without reindexing the actual keys
+        $this->assertSame($expected, $stream->padLeft($length, $fill)->toAssociativeArray());
+    }
+
+    public static function dataProviderForFiniteSources(): array
+    {
+        $fill = new \stdClass();
+        $value = new \stdClass();
+
+        return [
+            [[], 0, null, []],
+            [[], 3, null, [null, null, null]],
+            [['a' => 1], 3, ['x'], [['x'], ['x'], 1]],
+            [['a' => $value], 3, $fill, [$fill, $fill, $value]],
+            [['a' => null, 'b' => $value], 2, 'x', [null, $value]],
+            [['a' => null, 'b' => $value, 'c' => false, 'd' => ['x']], 2, $fill,
+                [null, $value, false, ['x']]],
+            [['a' => 1, 'b' => 2], 0, 'x', [1, 2]],
+        ];
+    }
+
+    /**
+     * @test padLeft rejects negative lengths on consumption before touching its source
+     */
+    public function testNegativeLengthIsLazy(): void
+    {
+        // Given
+        $pulled = [];
+        $stream = Stream::of(GeneratorFixture::getRecordingGenerator([1, 2], $pulled));
+
+        // When
+        $this->assertSame($stream, $stream->padLeft(-1, null));
+        $this->assertSame([], $pulled);
+
+        // Then
+        $this->expectException(\InvalidArgumentException::class);
+        try {
+            $stream->toArray();
+        } finally {
+            $this->assertSame([], $pulled);
+        }
+    }
+
+    /**
+     * @test         padLeft composes with partial consumption of unbounded or long sources
+     * @dataProvider dataProviderForPartialConsumption
+     */
+    public function testPartialConsumption(int $length, int $limit, ?int $size): void
+    {
+        // Given
+        $pulled = 0;
+        $allowed = $limit === 0 ? 0 : \max($length, $limit);
+        $source = (static function () use (&$pulled, $allowed, $size): \Generator {
+            for ($value = 1; $size === null || $value <= $size; ++$value) {
+                if ($pulled >= $allowed) {
+                    throw new \LogicException('Source advanced past the demanded prefix');
+                }
+                ++$pulled;
+                yield 'key' . $value => $value;
+            }
+        })();
+
+        // When
+        $stream = Stream::of($source)
+            ->map(fn (int $value): int => $value * 10)
+            ->padLeft($length, null)
+            ->limit($limit);
+        $this->assertSame(0, $pulled);
+        $result = $stream->toArray();
+
+        // Then
+        $expected = [];
+        for ($value = 1; $value <= $limit; ++$value) {
+            $expected[] = $value * 10;
+        }
+        $this->assertSame($expected, $result);
+        $this->assertSame($allowed, $pulled);
+    }
+
+    public static function dataProviderForPartialConsumption(): array
+    {
+        $cases = [];
+        foreach ([null, 1_000_000] as $size) {
+            foreach ([0, 1, 3] as $length) {
+                foreach ([0, 1, 2, 5] as $limit) {
+                    $cases[] = [$length, $limit, $size];
+                }
+            }
+        }
+        return $cases;
+    }
+}
