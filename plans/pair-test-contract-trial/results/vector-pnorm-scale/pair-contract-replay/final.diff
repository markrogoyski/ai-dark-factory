diff --git a/src/LinearAlgebra/Vector.php b/src/LinearAlgebra/Vector.php
index 37a2dd12..4327d223 100644
--- a/src/LinearAlgebra/Vector.php
+++ b/src/LinearAlgebra/Vector.php
@@ -694,10 +694,36 @@ class Vector implements \Countable, \Iterator, \ArrayAccess, \JsonSerializable,
      * https://en.wikipedia.org/wiki/Norm_(mathematics)#p-norm
      *
      * |x|p = (∑|xᵢ|ᵖ)¹/ᵖ
+     *
+     * For finite p >= 1, evaluated as s(∑(|xᵢ|/s)ᵖ)¹/ᵖ, where s = max|xᵢ|,
+     * to avoid overflow and underflow when raising extreme finite components to a power.
+     * Returns 0 for a zero vector and NAN if any component is NAN, even alongside infinity.
+     * Otherwise, returns positive INF for an infinite component or a norm exceeding the float range.
      */
     public function pNorm(int|float $p): int|float
     {
-        return \array_sum(Map\Single::pow(Map\Single::abs($this->A), $p)) ** (1 / $p);
+        if (!\is_finite($p) || $p < 1) {
+            return \array_sum(Map\Single::pow(Map\Single::abs($this->A), $p)) ** (1 / $p);
+        }
+
+        $s = 0.0;
+        foreach ($this->A as $xᵢ) {
+            if (\is_nan($xᵢ)) {
+                return \NAN;
+            }
+            $s = \max($s, \abs($xᵢ));
+        }
+
+        if ($s === 0.0 || \is_infinite($s)) {
+            return $s;
+        }
+
+        $∑ = 0.0;
+        foreach ($this->A as $xᵢ) {
+            $∑ += (\abs($xᵢ) / $s) ** $p;
+        }
+
+        return $s * $∑ ** (1 / $p);
     }
 
