+    /**
+     * @test         p norm remains finite across extreme component scales
+     * @param        array<int|float> $A
+     */
+    #[DataProvider('dataProviderForPNormExtremeMagnitudes')]
+    public function testPNormExtremeMagnitudes(array $A, int|float $p, float $expected): void
+    {
+        // Given
+        $V = new Vector($A);
+
+        // When
+        $norm = $V->pNorm($p);
+
+        // Then
+        $this->assertTrue(\is_finite($norm));
+        $this->assertGreaterThan(0.0, $norm);
+        $this->assertEqualsWithDelta($expected, $norm, \abs($expected) * 1e-12);
+    }
+
+    /**
+     * Expected values follow from absolute homogeneity: ||s x||p = |s| ||x||p.
+     * For x = [-3, 4], the 1-norm is 7 and the 2-norm is 5 (a Pythagorean triple).
+     * For x = [-1, 1], the p-norm is 2^(1/p), evaluated only at unit scale.
+     *
+     * @return array [A, p, expected]
+     */
+    public static function dataProviderForPNormExtremeMagnitudes(): array
+    {
+        $data = [];
+        foreach (['huge' => 1e200, 'tiny' => 1e-200] as $scale => $s) {
+            $data["$scale p=1"] = [[-3 * $s, 4 * $s], 1, 7 * $s];
+            $data["$scale p=2"] = [[-3 * $s, 4 * $s], 2, 5 * $s];
+            foreach ([4, 2.5, 1000] as $p) {
+                $data["$scale p=$p"] = [[-$s, $s], $p, 2 ** (1 / $p) * $s];
+            }
+        }
+
+        return $data;
+    }
+
