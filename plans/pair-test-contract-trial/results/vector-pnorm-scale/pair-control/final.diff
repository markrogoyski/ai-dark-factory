+    /**
+     * @test         p norm remains finite across component scales
+     * @param        array<int|float> $A
+     * @param        int|float        $p
+     * @param        float            $expected
+     */
+    #[DataProvider('dataProviderForPNormExtremeMagnitudes')]
+    public function testPNormExtremeMagnitudes(array $A, int|float $p, float $expected): void
+    {
+        // Given
+        $V = new Vector($A);
+
+        // When
+        $norm = $V->pNorm($p);
+
+        // Then
+        $this->assertTrue(\is_finite($norm));
+        $this->assertGreaterThan(0, $norm);
+        $this->assertEqualsWithDelta($expected, $norm, \abs($expected) * 1e-12);
+
+        if ($p == 1) {
+            $sum = \array_sum(\array_map(fn($x) => \abs($x), $A));
+            $this->assertEqualsWithDelta($sum, $norm, \abs($sum) * 1e-12);
+        }
+        if ($p == 2) {
+            $this->assertEqualsWithDelta($V->l2Norm(), $norm, \abs($expected) * 1e-12);
+        }
+    }
+
+    /**
+     * Analytical expectations, scaled by homogeneity:
+     *   p=1: |−3| + |4| = 7; p=2: the 3–4–5 triangle or two equal components.
+     *   p=1.5: (4^(3/2) + 9^(3/2))^(2/3) = 35^(2/3).
+     *   p=3: (1 + 8 + 8)^(1/3) = 17^(1/3).
+     *   p=4: four unit magnitudes give 4^(1/4) = sqrt(2).
+     *   Two equal magnitudes give 2^(1/p); a single magnitude gives itself.
+     * Mixed-scale corrections are below floating-point precision at 1e200.
+     *
+     * @return array [A, p, expected]
+     */
+    public static function dataProviderForPNormExtremeMagnitudes(): array
+    {
+        $cases = [];
+        foreach (['ordinary' => 1.0, 'huge' => 1e200, 'tiny' => 1e-200] as $scale => $s) {
+            $cases["$scale p=1"]          = [[-3 * $s, 0, 4 * $s], 1, 7 * $s];
+            $cases["$scale p=1.0"]        = [[-3 * $s, 0, 4 * $s], 1.0, 7 * $s];
+            $cases["$scale p=2 triangle"] = [[-3 * $s, 0, 4 * $s], 2, 5 * $s];
+            $cases["$scale p=2 equal"]    = [[$s, -$s], 2.0, \sqrt(2) * $s];
+            $cases["$scale p=1.5"]        = [[-4 * $s, 9 * $s], 1.5, 35 ** (2 / 3) * $s];
+            $cases["$scale p=3"]          = [[-$s, 2 * $s, -2 * $s], 3, 17 ** (1 / 3) * $s];
+            $cases["$scale p=4"]          = [[-$s, $s, -$s, $s], 4, \sqrt(2) * $s];
+            $cases["$scale p=10"]         = [[$s, -$s], 10, 2 ** (1 / 10) * $s];
+            $cases["$scale p=1024"]       = [[$s, -$s], 1024, 2 ** (1 / 1024) * $s];
+        }
+
+        foreach ([1, 2, 1.5, 3, 10, 1024] as $p) {
+            $cases["mixed scales p=$p"]          = [[-1e200, 1.0, 1e-200, 0], $p, 1e200];
+            $cases["reversed mixed scales p=$p"] = [[0, 1e-200, 1.0, -1e200], $p, 1e200];
+            $cases["single huge negative p=$p"]  = [[-1e200], $p, 1e200];
+            $cases["single tiny negative p=$p"]  = [[-1e-200], $p, 1e-200];
+        }
+
+        return $cases;
+    }
+
+    /**
+     * @test         p norm preserves zero and nonfinite results
