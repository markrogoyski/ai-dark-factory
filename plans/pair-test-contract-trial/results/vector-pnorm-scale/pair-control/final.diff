+            'positive infinity'             => [[\INF, 1.0], \INF],
+            'negative infinity'             => [[1.0, -\INF], \INF],
+            'both infinities'               => [[\INF, -\INF], \INF],
+            'nan only'                      => [[\NAN], \NAN],
+            'nan among finite components'   => [[1.0, \NAN, -2.0], \NAN],
+            'nan before positive infinity'  => [[\NAN, \INF], \NAN],
+            'nan after positive infinity'   => [[\INF, \NAN], \NAN],
+            'nan before negative infinity'  => [[\NAN, -\INF], \NAN],
+            'nan after negative infinity'   => [[-\INF, \NAN], \NAN],
+        ];
+
+        $cases = [];
+        foreach ([1, 2, 1.5, 3, 10, 1024] as $p) {
+            foreach ($vectors as $name => [$A, $expected]) {
+                $cases["$name p=$p"] = [$A, $p, $expected];
+            }
+        }
+        $cases['overflowing p=1 norm'] = [[1e308, 1e308], 1, \INF];
+        $cases['overflowing p=2 norm'] = [[1.7e308, 1.7e308], 2, \INF];
+
+        return $cases;
+    }
