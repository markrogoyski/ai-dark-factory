+     * @param        int|float        $p
+     * @param        float            $expected
+     */
+    #[DataProvider('dataProviderForPNormBoundaryValues')]
+    public function testPNormBoundaryValues(array $A, int|float $p, float $expected): void
+    {
+        // Given
+        $V = new Vector($A);
+
+        // When
+        $norm = $V->pNorm($p);
