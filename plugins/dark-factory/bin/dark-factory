#!/usr/bin/env python3
"""dark-factory: deterministic plumbing for the factory workflows. The code is the dark_factory_cli
package in ../lib; `dark-factory --help` lists the subcommands."""

import os
import sys

# The plugin's directory changes between installs, so the package is found next to this file. No
# bytecode is written: a __pycache__ inside the plugin would change a pinned engine's package content.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))

# Re-exported so that loading this file as a module still reaches every helper by name.
from dark_factory_cli import *  # noqa: E402,F401,F403
from dark_factory_cli import main  # noqa: E402

if __name__ == '__main__':
    main()
