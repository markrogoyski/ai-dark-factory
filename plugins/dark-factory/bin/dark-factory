#!/usr/bin/env python3
"""dark-factory — deterministic plumbing for the factory workflows.

The workflow script can only spawn Claude agents; it has no shell. Everything that has to be
deterministic — worktrees, snapshots, test runs, and driving the Codex and Gemini (agy) CLIs — lives here, and the
workflow's agents call it. Every subcommand prints one JSON object on its last line.

    dark-factory init        --repo DIR --seats A,B,C,D [--run-id ID] [--ref FILE]...
    dark-factory seat-run    --run-dir D [--vendor codex|gemini|claude] --seat KEY --job KEY --model M --effort E --cwd DIR
                        --prompt-file F --expect HASH [--sandbox MODE] [--writable DIR]... [--fresh]
                        [--checkout L-LABEL]   (first creates --cwd as a checkout of that snapshot)
                        (reads the payload from the relay's saved transcript when F is missing)
    dark-factory measure     --run-dir D --seat L --label rN [--since rM] [--tests T0A1,T1B2] [--no-snapshot]
                        [--replay-json JSON] [--brief]   (--brief: the result as Pair reads it, without
                        output tails; the job's status.json keeps the full record)
    dark-factory wait        --run-dir D --job KEY [--brief]
    dark-factory materialize --run-dir D --seat L --label rN [--name DIR]
    dark-factory usage       --run-dir D [--no-claude]
    dark-factory preflight   --vendors codex,gemini,claude
    dark-factory jobs        --run-dir D
    dark-factory cleanup     --run-dir D [--all]
    dark-factory retro       --run-dir D [--expect HASH] [--payload-file FILE] [--out-dir DIR]
                        (saves <run>/retro.md, plus the run's process notes read from the retro
                        agent's saved transcript, where they outlive the run)
    dark-factory hash        --file F

Long-running work (Codex and Gemini turns, test runs) executes as a detached job so it survives the 10-minute
Bash tool timeout: the command waits up to --max-wait seconds, then returns {"status": "running"}
and the caller polls with `dark-factory wait`.
"""

import argparse
from datetime import datetime, timezone
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
import hashlib
import json
import os
import re
import shutil
import shlex
import signal
import struct
import subprocess
import sys
import tempfile
import threading
import time
import uuid

SELF = os.path.realpath(__file__)
DEPS = ('vendor', 'node_modules')           # ignored dependency dirs cloned into each worktree
# Tool caches that test runs leave behind; never part of a seat's change, even when a project
# forgot to gitignore them.
SNAPSHOT_EXCLUDES = ('__pycache__/', '*.pyc', '.pytest_cache/', '.mypy_cache/', '.ruff_cache/',
                     '.phpunit.result.cache', '.phpunit.cache/', '.php-cs-fixer.cache', '.DS_Store',
                     'node_modules/', '.tox/', '.nyc_output/',
                     # agent instructions init copies in when git ignores them (perhaps only through the
                     # user's global excludes, which this file replaces); a tracked one still diffs
                     '/CLAUDE.md', '/CLAUDE.local.md', '/AGENTS.md', '/GEMINI.md')
ROOM_DIRS = ('r0', 'r1', 'r2', 'r3', 'r4', 'r5', 'final', 'final2', 'ratify', 'audit', 'final3', 'reaudit', 'tests')
SCHEMA_OPEN, SCHEMA_CLOSE = '<<<OUTPUT_SCHEMA', 'OUTPUT_SCHEMA>>>'
DEFAULT_MAX_WAIT = 540                      # stays under the Bash tool's 600 s ceiling
# How often waits poll. Tests set these small through the environment; real runs keep the defaults.
JOB_POLL_SEC = float(os.environ.get('COUNCIL_JOB_POLL', '2'))
TRANSCRIPT_POLL_SEC = float(os.environ.get('COUNCIL_TRANSCRIPT_POLL', '1'))
TRANSCRIPT_WAIT_SEC = float(os.environ.get('COUNCIL_TRANSCRIPT_WAIT', '10'))
TAIL_LINES = 40
# Keep tool discovery, locale, identity and temporary paths stable across roles. Project-specific
# variables belong in verification.json; a builder's shell exports must not leak into a gate.
VERIFICATION_BASE_ENV = ('PATH', 'HOME', 'USER', 'LOGNAME', 'SHELL', 'TMPDIR', 'TMP', 'TEMP',
                         'LANG', 'LC_ALL', 'LC_CTYPE', 'SYSTEMROOT')
EXECUTOR_CONTEXT = ('DARK_FACTORY_PIN', 'DARK_FACTORY_INVOCATION', 'DARK_FACTORY_SEAT_SPEC')


class CouncilError(Exception):
    pass


# ---------------------------------------------------------------- output

def emit(obj):
    print(json.dumps(obj, ensure_ascii=False))
    sys.stdout.flush()


def fail(msg):
    emit({'status': 'error', 'error': msg, **({'code': 'ENGINE_DRIFT', 'errorClass': 'engine'} if str(msg).startswith('ENGINE_DRIFT:') else {})})
    sys.exit(1)


# ---------------------------------------------------------------- prompt hash
# Must match promptHash() in council.js exactly: CRLF -> LF, strip trailing [ \t\n],
# then "<length>-<fnv1a32>" over UTF-16 code units.

def normalize(text):
    return re.sub(r'[ \t\n]+\Z', '', text.replace('\r\n', '\n'))


def prompt_hash(text):
    t = normalize(text)
    raw = t.encode('utf-16-le')
    units = struct.unpack('<%dH' % (len(raw) // 2), raw)
    h = 0x811C9DC5
    for u in units:
        h = ((h ^ u) * 0x01000193) & 0xFFFFFFFF
    return '%d-%08x' % (len(units), h)


def split_schema(payload):
    """Pull the <<<OUTPUT_SCHEMA ... OUTPUT_SCHEMA>>> block out of a prompt payload."""
    start = payload.find(SCHEMA_OPEN)
    if start < 0:
        return payload, None
    end = payload.find(SCHEMA_CLOSE, start)
    if end < 0:
        raise CouncilError('payload has an unterminated OUTPUT_SCHEMA block')
    schema_text = payload[start + len(SCHEMA_OPEN):end].strip()
    try:
        schema = json.loads(schema_text)
    except json.JSONDecodeError as e:
        raise CouncilError(f'OUTPUT_SCHEMA block is not valid JSON: {e}')
    prompt = (payload[:start] + payload[end + len(SCHEMA_CLOSE):]).strip() + '\n'
    return prompt, schema


# ---------------------------------------------------------------- helpers

def git(*args, cwd=None, env=None, check=True):
    r = subprocess.run(['git', *args], cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                       capture_output=True, text=True, close_fds=True)
    if check and r.returncode != 0:
        raise CouncilError(f"git {' '.join(args)} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def read(path):
    with open(path, encoding='utf-8') as f:
        return f.read()


def pin_guard(run_dir=None, spec=None, repo=None, final=None):
    """Every process, including detached jobs, validates its own shipped executor."""
    pin = json.loads(os.environ['DARK_FACTORY_PIN']) if os.environ.get('DARK_FACTORY_PIN') else None
    if spec and spec.get('pin'):
        saved = spec['pin']
        if pin and any(pin.get(k) != saved.get(k) for k in ('packageDigest', 'sourceRevision', 'algorithm')):
            raise CouncilError('ENGINE_DRIFT: job executor differs from environment')
        pin = pin or saved
    if run_dir and os.path.isfile(os.path.join(run_dir, 'run.json')):
        metadata = json.loads(read(os.path.join(run_dir, 'run.json')))
        saved = metadata.get('pin')
        repo = repo or metadata.get('repoRoot')
        if saved:
            if pin and any(pin.get(k) != saved.get(k) for k in ('packageDigest', 'sourceRevision', 'algorithm')):
                raise CouncilError('ENGINE_DRIFT: run executor differs from environment')
            pin = pin or saved
    own_root = os.path.realpath(os.path.join(os.path.dirname(SELF), '..'))
    own_export = os.path.basename(own_root) == 'plugin' and os.path.isfile(os.path.join(os.path.dirname(own_root), 'manifest.json'))
    if not pin and not own_export:
        return None
    if pin and own_export:
        pin = dict(pin, root=own_root)
    adapter = os.path.join(os.path.dirname(SELF), '..', 'lib', 'engine.mjs')
    request = {'pin': pin, 'executable': SELF, 'spec': spec, 'repo': repo, 'final': final}
    r = subprocess.run(['node', adapter, 'guard'], input=json.dumps(request), text=True, capture_output=True, close_fds=True)
    if r.stderr:
        sys.stderr.write(r.stderr)
    try:
        out = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise CouncilError('ENGINE_DRIFT: executor validator did not return a result: ' + r.stderr[-1000:])
    if r.returncode or out.get('status') == 'error':
        raise CouncilError('ENGINE_DRIFT: ' + out.get('error', 'executor validation failed'))
    os.environ['DARK_FACTORY_PIN'] = json.dumps(out['executor'])
    os.environ['PATH'] = os.path.join(out['executor']['root'], 'bin') + os.pathsep + os.environ.get('PATH', '')
    return out


def subject_environment(env=None):
    """Executor context belongs to control processes, never the candidate under test."""
    return {k: v for k, v in (os.environ if env is None else env).items() if k not in EXECUTOR_CONTEXT}


def turn_pin_identity(pin):
    return {k: v for k, v in (pin or {}).items() if k not in ('root', 'locations')}


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(text)
    os.replace(tmp, path)


def write_json(path, obj):
    write(path, json.dumps(obj, indent=2, ensure_ascii=False) + '\n')


def tail(text, n=TAIL_LINES):
    lines = text.rstrip('\n').split('\n')
    return '\n'.join(lines[-n:])


def load_run(run_dir):
    path = os.path.join(run_dir, 'run.json')
    if not os.path.exists(path):
        raise CouncilError(f'not a council run directory (no run.json): {run_dir}')
    return json.loads(read(path))


def seat_tree(run, seat):
    return os.path.join(run['runDir'], 'wt', seat)


def clone_deps(src_root, dst_root):
    """Copy ignored dependency dirs (vendor/, node_modules/) into a fresh worktree.

    A real copy, not a symlink: Composer's autoloader resolves __DIR__ through symlinks, so a
    symlinked vendor/ would silently autoload the *main* tree's classes. On APFS `cp -c` clones
    copy-on-write, so this is near-instant and costs no disk.
    """
    cloned = []
    for d in DEPS:
        src, dst = os.path.join(src_root, d), os.path.join(dst_root, d)
        if not os.path.isdir(src) or os.path.exists(dst):
            continue
        ignored = subprocess.run(['git', 'check-ignore', '-q', d], cwd=src_root,
                                 stdin=subprocess.DEVNULL, close_fds=True).returncode == 0
        if not ignored:
            continue
        r = subprocess.run(['cp', '-cR', src, dst], stdin=subprocess.DEVNULL, capture_output=True, close_fds=True)
        if r.returncode != 0:
            shutil.rmtree(dst, ignore_errors=True)
            r = subprocess.run(['cp', '-R', src, dst], stdin=subprocess.DEVNULL, capture_output=True, close_fds=True)
        if r.returncode != 0:
            shutil.rmtree(dst, ignore_errors=True)
            copy_skipping_protected(src, dst)
        cloned.append(d)
    return cloned


# Claude Code's sandbox always denies writing files with these names, wherever they are, so a
# Claude setup turn on the standalone runner can't copy them (vendor/amphp/serialization ships a
# .gitmodules). None of them is loaded by a dependency at run time.
SANDBOX_PROTECTED = frozenset(('.gitmodules', '.gitconfig', '.bashrc', '.bash_profile', '.zshrc', '.zprofile', '.profile', '.ripgreprc', '.mcp.json'))


def copy_skipping_protected(src, dst):
    """Copy a dependency tree, leaving out the sandbox-protected files the copy is refused."""
    skipped = []

    def copy(a, b):
        try:
            return shutil.copy2(a, b)
        except PermissionError:
            if os.path.basename(a) not in SANDBOX_PROTECTED:
                raise
            skipped.append(os.path.relpath(a, src))
            return b

    shutil.copytree(src, dst, symlinks=True, copy_function=copy)
    for rel in skipped:
        print(f'dark-factory: skipped sandbox-protected {os.path.join(os.path.basename(src), rel)}', file=sys.stderr)
    return skipped


def run_shell(cmd, cwd, timeout, log_path, env=None):
    """Run a command in its own process group; expose its PID until it exits.

    A host runner cancelling a measurement can signal <log_path>.pid as well as the detached
    measurement job. Removing this sidecar on every exit avoids signalling an unrelated process
    after the operating system reuses its PID.
    """
    env = subject_environment(env)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    started = time.time()
    pid_path, p = log_path + '.pid', None
    timed_out = False
    try:
        with open(log_path, 'w', encoding='utf-8', errors='replace') as log:
            p = subprocess.Popen(['/bin/bash', '-c', cmd], cwd=cwd, stdin=subprocess.DEVNULL,
                                 stdout=log, stderr=subprocess.STDOUT, start_new_session=True, env=env, close_fds=True)
            write(pid_path, str(p.pid))
            try:
                code = p.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                timed_out = True
                try:
                    os.killpg(p.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                code = p.wait()
    finally:
        try:
            if p is not None and p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                p.wait()
        finally:
            try:
                os.remove(pid_path)
            except FileNotFoundError:
                pass
    output = read(log_path) if os.path.exists(log_path) else ''
    return {'exitCode': code, 'timedOut': timed_out, 'seconds': round(time.time() - started, 1),
            'tail': tail(output), 'log': log_path}


# ---------------------------------------------------------------- init

REF_MAX_BYTES = 5 * 1024 * 1024


def resolve_refs(root, refs):
    """Absolute paths of the reference documents (a plan, a checklist, a spec): ~ expanded, relative
    paths tried against the repo root, then the current directory. Raises before anything is created."""
    out = []
    for ref in refs or []:
        p = os.path.expanduser(ref)
        tries = [p] if os.path.isabs(p) else [os.path.join(root, p), os.path.abspath(p)]
        found = next((t for t in tries if os.path.exists(t)), None)
        if not found:
            raise CouncilError(f'reference document not found: {ref}')
        if not os.path.isfile(found):
            raise CouncilError(f'reference document is not a file (pass files, not directories): {ref}')
        if os.path.getsize(found) > REF_MAX_BYTES:
            raise CouncilError(f'reference document is over {REF_MAX_BYTES // (1024 * 1024)} MB: {ref}')
        out.append(os.path.realpath(found))
    return out


def in_worktrees(root, path):
    """Whether a seat's worktree has this file as it is now: committed at HEAD and unmodified."""
    rel = os.path.relpath(path, os.path.realpath(root))
    if rel.startswith('..'):
        return False
    tracked = git('ls-files', '--error-unmatch', '--', rel, cwd=root, check=False)
    if not tracked.strip():
        return False
    return subprocess.run(['git', 'diff', '--quiet', 'HEAD', '--', rel], cwd=root, stdin=subprocess.DEVNULL,
                          capture_output=True, close_fds=True).returncode == 0


def copy_refs(root, run_dir, paths):
    """Snapshot the reference documents into <run>/refs/, where every seat can read them: worktrees
    check out HEAD, so an uncommitted plan is invisible there. Copied by the CLI, not by a model."""
    dest_dir = os.path.join(run_dir, 'refs')
    os.makedirs(dest_dir, exist_ok=True)
    out, used = [], set()
    for src in paths:
        base, ext = os.path.splitext(os.path.basename(src))
        name, n = base + ext, 2
        while name in used:
            name, n = f'{base}-{n}{ext}', n + 1
        used.add(name)
        dest = os.path.join(dest_dir, name)
        shutil.copyfile(src, dest)
        out.append({'source': src, 'path': dest, 'bytes': os.path.getsize(dest), 'inWorktrees': in_worktrees(root, src)})
    return out


AGENT_DOCS = ('CLAUDE.md', 'CLAUDE.local.md', 'AGENTS.md', 'GEMINI.md')


def copy_agent_docs(root, wt, untracked=False):
    """Copy ignored instructions, and untracked ones for Factory, into isolated checkouts.
    Snapshot exclusions keep these local instructions out of the delivered change."""
    copied = []
    for name in AGENT_DOCS:
        src, dst = os.path.join(root, name), os.path.join(wt, name)
        if not os.path.isfile(src) or os.path.exists(dst):
            continue
        ignored = subprocess.run(['git', 'check-ignore', '-q', name], cwd=root, stdin=subprocess.DEVNULL,
                                 capture_output=True, close_fds=True).returncode == 0
        if ignored or (untracked and not git('ls-files', '--', name, cwd=root).strip()):
            shutil.copy2(src, dst)
            copied.append(name)
    return copied


def cmd_init(a):
    repo = os.path.abspath(a.repo or os.getcwd())
    root = git('rev-parse', '--show-toplevel', cwd=repo).strip()
    head = git('rev-parse', '--verify', '--quiet', 'HEAD', cwd=root, check=False).strip()
    if not head:
        raise CouncilError('the repository has no commits yet; council worktrees branch from HEAD')
    ref_paths = resolve_refs(root, a.ref)
    common = git('rev-parse', '--git-common-dir', cwd=root).strip()
    if not os.path.isabs(common):
        common = os.path.normpath(os.path.join(root, common))

    run_id = a.run_id or time.strftime('%Y%m%d-%H%M%S')
    if not re.fullmatch(r'[A-Za-z0-9._-]+', run_id):
        raise CouncilError(f'invalid run id: {run_id}')
    run_dir = os.path.join(root, '.council', run_id)
    seats = [s for s in a.seats.split(',') if s]
    if not seats or any(not re.fullmatch(r'[A-Z]', s) for s in seats):
        raise CouncilError('--seats must be single capital letters, e.g. A,B,C,D')

    # Keep .council/ out of `git status` and out of ripgrep, locally, without touching .gitignore.
    exclude = os.path.join(common, 'info', 'exclude')
    os.makedirs(os.path.dirname(exclude), exist_ok=True)
    existing = read(exclude) if os.path.exists(exclude) else ''
    if '/.council/' not in existing.split('\n'):
        with open(exclude, 'a', encoding='utf-8') as f:
            f.write(('' if existing.endswith('\n') or not existing else '\n') + '/.council/\n')

    created = not os.path.exists(run_dir)
    for d in ('jobs', 'logs', 'seats', 'wt', 'snap', 'tmp', 'scratch'):
        os.makedirs(os.path.join(run_dir, d), exist_ok=True)
    for d in ROOM_DIRS:
        os.makedirs(os.path.join(run_dir, 'room', d), exist_ok=True)

    worktrees, deps, docs = {}, [], []
    for s in seats:
        path = os.path.join(run_dir, 'wt', s)
        if not os.path.exists(path):
            try:
                git('worktree', 'add', '--detach', path, head, cwd=root)
            except CouncilError as e:
                # Seats commit in their worktrees, so a seat has no standalone fallback. Leave no
                # half-made run behind for the retry to trip over.
                if created:
                    for added in worktrees.values():
                        git('worktree', 'remove', '--force', added, cwd=root, check=False)
                    shutil.rmtree(run_dir, ignore_errors=True)
                    git('worktree', 'prune', cwd=root, check=False)
                hint = (' A sandbox refused to write the worktree records: run init again with the sandbox disabled.'
                        if 'Operation not permitted' in str(e) or 'Permission denied' in str(e) else '')
                raise CouncilError(f'{e}.{hint}')
        deps = clone_deps(root, path) or deps
        docs = copy_agent_docs(root, path, untracked=getattr(a, 'factory', False))
        worktrees[s] = path

    dirty = [l for l in git('status', '--porcelain', '--untracked-files=no', cwd=root).split('\n') if l]
    untracked = [l for l in git('status', '--porcelain', cwd=root).split('\n') if l.startswith('??')]

    refs = copy_refs(root, run_dir, ref_paths)

    run = {'runId': run_id, 'runDir': run_dir, 'repoRoot': root, 'head': head, 'seats': seats,
           'room': os.path.join(run_dir, 'room'), 'cli': SELF, 'refs': refs}
    if os.environ.get('DARK_FACTORY_PIN'):
        run['pin'] = json.loads(os.environ['DARK_FACTORY_PIN'])
    if getattr(a, 'factory', False):
        run['factory'] = True
        run['verificationBaseEnv'] = {k: os.environ[k] for k in VERIFICATION_BASE_ENV if k in os.environ}
        run['deliveryBaseline'] = {p: checkout_file(root, p) for p in checkout_changes(root)}
        config = os.path.join(run_dir, 'verification.json')
        if not os.path.exists(config):
            write_json(config, {'env': {}})
    run_path = os.path.join(run_dir, 'run.json')
    if not os.path.exists(run_path):
        write_json(run_path, dict(run, created=time.strftime('%Y-%m-%dT%H:%M:%S')))
    started = setup_started(getattr(a, 'started_at', None))
    if started:
        timeline_event(run_dir, 'setup-start', at=started)
    timeline_event(run_dir, 'init')
    emit(dict(run, status='ok', worktrees=worktrees, depsCloned=deps, agentDocs=docs,
              dirty=dirty, untrackedCount=len(untracked)))


# ---------------------------------------------------------------- jobs

def job_dir(run_dir, key):
    if not re.fullmatch(r'[A-Za-z0-9._-]+', key):
        raise CouncilError(f'invalid job key: {key}')
    return os.path.join(run_dir, 'jobs', key)


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:                  # exists, but we may not signal it (e.g. from inside a sandbox)
        return True


def job_state(jd):
    status = os.path.join(jd, 'status.json')
    if os.path.exists(status):
        return json.loads(read(status))
    pid_file = os.path.join(jd, 'pid')
    if os.path.exists(pid_file) and pid_alive(int(read(pid_file).strip() or 0)):
        return {'status': 'running'}
    if os.path.exists(os.path.join(jd, 'spec.json')):
        err = os.path.join(jd, 'runner.err')
        return {'status': 'error', 'error': 'job runner died: ' + (tail(read(err), 10) if os.path.exists(err) else 'no output')}
    return None


def start_job(jd, spec):
    checked = pin_guard(spec.get('runDir'))
    if checked:
        spec['pin'] = checked['executor']
    os.makedirs(jd, exist_ok=True)
    write_json(os.path.join(jd, 'spec.json'), spec)
    with open(os.path.join(jd, 'runner.err'), 'w') as err:
        p = subprocess.Popen([sys.executable, SELF, '_job', jd], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=err, start_new_session=True, close_fds=True)
    write(os.path.join(jd, 'pid'), str(p.pid))
    keep_awake(p.pid)


def keep_awake(pid):
    """Idle sleep on a Mac stalls a long measurement or CLI turn. `caffeinate -w` exits by itself
    when the job does. -i prevents idle sleep only: closing the lid still sleeps the machine."""
    if sys.platform != 'darwin' or os.environ.get('DARK_FACTORY_KEEP_AWAKE') == '0':
        return
    tool = shutil.which('caffeinate')
    if not tool:
        return
    try:
        subprocess.Popen([tool, '-i', '-w', str(pid)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    except OSError:
        pass


def wait_job(jd, key, max_wait):
    deadline = time.time() + max_wait
    while True:
        state = job_state(jd)
        if state and state.get('status') != 'running':
            return state
        if time.time() >= deadline:
            return {'status': 'running', 'job': key,
                    'hint': 'still working; poll again with `dark-factory wait --run-dir ... --job ' + key + '`'}
        time.sleep(JOB_POLL_SEC)


def archive_job(jd):
    n = 1
    while os.path.exists(f'{jd}.old{n}'):
        n += 1
    os.replace(jd, f'{jd}.old{n}')


def settle_existing_job(jd, key, max_wait, decide, show=None):
    """A job directory for this key may already exist. `decide(old_spec, state)` says what to do with
    it: 'wait' (it is this work, running or done: wait for it and return its result), a dict (emit
    that, e.g. a reused result), or None (it is stale or failed: archive it). True when the request
    was answered from the existing job; False when the caller should start a new one. `show` prints
    the answer (default emit)."""
    if not os.path.isdir(jd):
        return False
    spec_path = os.path.join(jd, 'spec.json')
    old = json.loads(read(spec_path)) if os.path.exists(spec_path) else {}
    action = decide(old, job_state(jd))
    if action is None:
        archive_job(jd)
        return False
    (show or emit)(wait_job(jd, key, max_wait) if action == 'wait' else action)
    return True


def cmd_wait(a):
    jd = job_dir(a.run_dir, a.job)
    if not os.path.isdir(jd):
        raise CouncilError(f'no such job: {a.job}')
    if a.brief and not a.job.startswith('measure-'):
        raise CouncilError('--brief applies only to measurement jobs')
    state = wait_job(jd, a.job, a.max_wait)
    emit(measurement_brief(state) if a.brief else state)


def cmd_jobs(a):
    root = os.path.join(a.run_dir, 'jobs')
    rows = []
    for key in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        jd = os.path.join(root, key)
        if os.path.isdir(jd) and '.old' not in key:
            st = job_state(jd) or {'status': 'empty'}
            rows.append({'job': key, 'status': st.get('status'), 'seconds': st.get('elapsedSec'),
                         'error': (st.get('error') or '')[:200]})
    emit({'status': 'ok', 'jobs': rows})


# ---------------------------------------------------------------- codex seats

PAYLOAD_OPEN, PAYLOAD_CLOSE = '=====BEGIN PAYLOAD {}=====', '=====END PAYLOAD {}====='
TRANSCRIPT_MAX_AGE = 6 * 3600


def extract_payload(text, expect):
    """The payload between the markers for `expect`, without the indent the workflow harness puts
    in front of every line of an agent's prompt; None unless it hashes to `expect`."""
    lines = text.split('\n')
    begin, end = PAYLOAD_OPEN.format(expect), PAYLOAD_CLOSE.format(expect)
    starts = [i for i, line in enumerate(lines) if line.strip() == begin]
    ends = [i for i, line in enumerate(lines) if line.strip() == end]
    if not starts or not ends or ends[-1] <= starts[0]:
        return None
    first = lines[starts[0]]
    indent = first[:len(first) - len(first.lstrip(' \t'))]
    body = []
    for line in lines[starts[0] + 1:ends[-1]]:
        if line.startswith(indent):
            body.append(line[len(indent):])
        elif not line.strip():
            body.append('')
        else:
            return None
    payload = '\n'.join(body)
    return payload if prompt_hash(payload) == expect else None


def transcript_texts(path, needle):
    """Message texts in a Claude Code transcript (JSONL) that contain `needle`."""
    with open(path, 'rb') as f:
        data = f.read()
    raw_needle = needle.encode()
    if raw_needle not in data:
        return
    for raw in data.split(b'\n'):
        if raw_needle not in raw:
            continue
        try:
            content = json.loads(raw).get('message', {}).get('content')
        except (ValueError, AttributeError):
            continue
        if isinstance(content, str):
            yield content
        elif isinstance(content, list):
            for block in content:
                if isinstance(block, dict) and isinstance(block.get('text'), str):
                    yield block['text']


def payload_from_transcripts(expect, wait=10):
    """Claude Code saves every agent's prompt in its transcript, so read the relay's payload from
    there instead of having a model copy it: small models drop and add lines in long copies. The
    hash check makes this safe; None if no saved prompt matches."""
    base = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.expanduser('~/.claude')
    root = os.path.join(base, 'projects')
    needle = PAYLOAD_OPEN.format(expect)
    deadline = time.time() + wait
    while True:
        now, found = time.time(), []
        for dirpath, _, names in os.walk(root):
            for name in names:
                if name.startswith('agent-') and name.endswith('.jsonl'):
                    path = os.path.join(dirpath, name)
                    try:
                        mtime = os.path.getmtime(path)
                    except OSError:
                        continue
                    if now - mtime < TRANSCRIPT_MAX_AGE:
                        found.append((mtime, path))
        for _, path in sorted(found, reverse=True):
            try:
                for text in transcript_texts(path, needle):
                    payload = extract_payload(text, expect)
                    if payload is not None:
                        return payload
            except OSError:
                continue
        if time.time() >= deadline:            # the transcript may not be flushed the instant the agent starts
            return None
        time.sleep(TRANSCRIPT_POLL_SEC)


def home_blocked(home, who, create=False):
    """Codex and agy write to their home directory as they start, and need the network. Inside Claude
    Code's sandbox that write fails with EPERM; report it plainly now instead of as an opaque vendor
    error later. None when the directory is writable. With `create`, a missing directory is made
    (Codex makes its own); without, a missing one is an error: the CLI isn't set up."""
    try:
        if create:
            os.makedirs(home, exist_ok=True)
        fd, probe = tempfile.mkstemp(prefix='.council-probe-', dir=home)
        os.close(fd)
        os.unlink(probe)
        return None
    except OSError as e:
        if isinstance(e, FileNotFoundError) and not create:
            raise CouncilError(f'{home} does not exist: install the Antigravity CLI (agy) and log in')
        return (f'cannot write to {home} ({e.strerror}). This command is running inside a sandbox; '
                f'{who} needs to run outside it, with network access.')


def codex_blocked():
    return home_blocked(os.environ.get('CODEX_HOME') or os.path.expanduser('~/.codex'), 'Codex', create=True)


def claude_blocked():
    return home_blocked(os.environ.get('CLAUDE_CONFIG_DIR') or os.path.expanduser('~/.claude'), 'Claude', create=True)


def vendor_blocked(vendor):
    return {'codex': codex_blocked, 'gemini': gemini_blocked, 'claude': claude_blocked}[vendor]()


def agy_home():
    return os.path.expanduser('~/.gemini/antigravity-cli')


def gemini_blocked():
    return home_blocked(agy_home(), 'agy')


def ensure_agy_grant(grant_dir):
    """A Gemini seat runs headless, where agy can't ask for anything: it needs the global
    `proceed-in-sandbox` mode, so commands run in agy's sandbox without prompting, and a write
    grant for the run's files. The grant is one per repository (<repo>/.council), added once."""
    path = os.path.join(agy_home(), 'settings.json')
    settings = json.loads(read(path)) if os.path.exists(path) else {}
    if settings.get('toolPermission') != 'proceed-in-sandbox':
        raise CouncilError(f'Gemini seats need "toolPermission": "proceed-in-sandbox" in {path} '
                           '(headless agy otherwise denies every command and file edit)')
    rule = f'write_file({grant_dir})'
    perms = settings.setdefault('permissions', {})
    allow = perms.setdefault('allow', [])
    if rule in allow:
        return
    allow.append(rule)
    tmp = f'{path}.council-{os.getpid()}'
    write(tmp, json.dumps(settings, indent=2) + '\n')
    os.replace(tmp, path)


def cmd_seat_run(a):
    checked = pin_guard(getattr(a, 'run_dir', None))
    if checked:
        bounds = {'kind': a.vendor, 'cwd': os.path.abspath(a.cwd), 'writable': [os.path.abspath(w) for w in (a.writable or [])],
                  'runDir': os.path.abspath(a.run_dir), 'job': a.job, 'sandbox': a.sandbox}
        bounds['gitRoots'] = seat_git_dirs(bounds)
        if a.vendor == 'claude':
            bounds['writable'] += [claude_tmp_dir(bounds)]
        elif a.vendor == 'gemini':
            bounds['writable'] += [os.path.join(tempfile.gettempdir(), 'council-agy')]
        checked = pin_guard(a.run_dir, bounds)
    blocked = vendor_blocked(a.vendor)   # first: inside the sandbox, the transcripts may be unreadable too
    if blocked:
        emit({'status': 'sandboxed', 'error': blocked})
        return
    if a.vendor == 'gemini' and not checked:
        ensure_agy_grant(os.path.dirname(os.path.abspath(a.run_dir)))   # fails now, not inside the job
    if a.checkout:
        # An auditor works in a checkout of the version under review, made here, outside the
        # vendor's sandbox, which can't write the repository's worktree records.
        seat, _, label = a.checkout.partition('-')
        checkout_snapshot(load_run(a.run_dir), seat, label, os.path.abspath(a.cwd))
    text = read(a.prompt_file) if os.path.exists(a.prompt_file) else None
    got = prompt_hash(text) if text is not None else None
    if a.expect and got != a.expect:
        found = None if getattr(a, 'no_transcript', False) else payload_from_transcripts(a.expect, a.transcript_wait)
        if found is not None:
            write(a.prompt_file, found)
            text, got = found, a.expect
        elif text is None:
            emit({'status': 'need-file', 'expected': a.expect,
                  'hint': 'The payload could not be read from the saved prompt. Write it to the prompt file exactly and retry.'})
            return
        else:
            emit({'status': 'hash-mismatch', 'expected': a.expect, 'got': got,
                  'hint': 'The prompt file is not an exact copy of the payload. Rewrite it exactly and retry.'})
            return
    if text is None:
        raise CouncilError(f'no prompt file: {a.prompt_file}')
    prompt, schema = split_schema(normalize(text))

    spec = {
        'kind': a.vendor, 'runDir': os.path.abspath(a.run_dir), 'seat': a.seat, 'job': a.job,
        'hash': got, 'model': a.model, 'effort': a.effort, 'sandbox': a.sandbox,
        'cwd': os.path.abspath(a.cwd), 'writable': [os.path.abspath(w) for w in (a.writable or [])],
        'fresh': bool(a.fresh), 'timeout': a.timeout_min * 60, 'schema': schema is not None,
        'resumeSession': getattr(a, 'resume_session', None),
    }
    if checked:
        spec.update(writable=bounds['writable'], gitRoots=bounds['gitRoots'], settingsVersion=checked['settings']['settingsVersion'], settingsHash=checked['settings']['settingsHash'], settingsSources=checked['settings']['sources'], pin=checked['executor'])
    jd = job_dir(a.run_dir, a.job)

    def decide(old, state):
        if checked and old.get('pin') and old.get('settingsHash') != spec.get('settingsHash'):
            raise CouncilError('ENGINE_DRIFT: Admitted provider settings changed; preserve this job and start a new run')
        same = (all(old.get(k) == spec.get(k) for k in TURN_IDENTITY)
                and turn_pin_identity(old.get('pin')) == turn_pin_identity(spec.get('pin')))
        status = state and state.get('status')
        if same and status in ('running', 'done'):
            return 'wait'                                # the same turn: reuse the result or keep waiting
        if same and status == 'error' and recently_failed_twice(jd, got):
            # A relay that reruns a failed turn again and again only repeats the failure (Gemini's
            # B-r1 ran four times, four minutes each). One rerun is allowed; then the error stands.
            return dict(state, repeated=True, hint='This exact turn has already failed twice. Return this error; do not run it again.')
        return None                                      # failed before, or same key with a new prompt

    if settle_existing_job(jd, a.job, a.max_wait, decide):
        return

    os.makedirs(jd, exist_ok=True)
    write(os.path.join(jd, 'prompt.md'), prompt)
    if schema is not None:
        write_json(os.path.join(jd, 'schema.json'), schema)
    start_job(jd, spec)
    emit(wait_job(jd, a.job, a.max_wait))


# What makes two seat-run calls the same turn: a job is reused only when all of these match.
TURN_IDENTITY = ('kind', 'hash', 'model', 'effort', 'sandbox', 'cwd', 'writable', 'fresh', 'schema', 'resumeSession', 'settingsHash')
RERUN_WINDOW = 1800      # a failure older than this may be retried again (after a quota reset, say)


def recently_failed_twice(jd, got):
    """Whether this turn (same prompt hash) already failed, was rerun, and failed again, within the
    last half hour. The current job is the latest failure; an archived one is the earlier."""
    status = os.path.join(jd, 'status.json')
    if not os.path.exists(status) or time.time() - os.path.getmtime(status) > RERUN_WINDOW:
        return False
    n = 1
    while os.path.exists(f'{jd}.old{n}'):
        old = f'{jd}.old{n}'
        n += 1
        try:
            if (json.loads(read(os.path.join(old, 'spec.json'))).get('hash') == got
                    and json.loads(read(os.path.join(old, 'status.json'))).get('status') == 'error'):
                return True
        except (OSError, ValueError):
            continue
    return False


def record_usage(run_dir, spec, usage, thread_total, started):
    """Append one vendor turn to the run's usage.jsonl: this turn's share, and the thread's running total."""
    with open(os.path.join(run_dir, 'usage.jsonl'), 'a') as f:
        f.write(json.dumps({'job': spec['job'], 'seat': spec['seat'], 'model': spec['model'],
                            'usage': usage, 'threadTotal': thread_total,
                            'seconds': round(time.time() - started, 1)}) + '\n')


def turn_usage(seat_dir, thread_id, reported):
    """This turn's share of a thread's usage. On `codex exec resume`, turn.completed reports the
    whole thread's running total, so subtract the total recorded after the previous turn."""
    if not reported or not thread_id:
        return reported
    path = os.path.join(seat_dir, 'usage-total.json')
    prev = {}
    if os.path.exists(path):
        rec = json.loads(read(path))
        if rec.get('thread') == thread_id:
            prev = rec.get('usage', {})
    turn = {k: v - prev.get(k, 0) for k, v in reported.items()}
    if any(v < 0 for v in turn.values()):                 # a total that went down isn't a running total
        turn = dict(reported)
    write_json(path, {'thread': thread_id, 'usage': reported})
    return turn


def seat_git_dirs(spec):
    """The git data a commit in a seat's worktree writes: its own git dir (HEAD, index, reflog) and
    the shared object store. Codex's sandbox keeps both read-only unless they are writable roots;
    the rest of .git (config, refs, hooks) stays read-only. Only for a seat worktree under wt/."""
    cwd = os.path.realpath(spec['cwd'])
    if not cwd.startswith(os.path.realpath(os.path.join(spec['runDir'], 'wt')) + os.sep):
        return []
    out = git('rev-parse', '--path-format=absolute', '--git-dir', '--git-common-dir', cwd=cwd, check=False).split('\n')
    if len(out) < 2 or not out[0] or out[0] == out[1]:
        return []
    return [out[0], os.path.join(out[1], 'objects')]


def codex_command(jd, spec, thread):
    """The `codex exec` command for a job, and the directory it runs in (the prompt goes on stdin)."""
    run_dir = spec['runDir']
    # A read-only turn (panel, spec review) must not change the repository, but Codex's read-only
    # sandbox also forbids temp files, which zsh heredocs and Rscript need. So it runs in
    # workspace-write from an empty scratch directory: it can read everything, and write only
    # there and to the temp directories.
    sandbox, cwd = spec['sandbox'], spec['cwd']
    # Output recovery needs no shell probes or temp files, and must drop the seat's write access.
    if sandbox == 'read-only' and not spec.get('resumeSession'):
        sandbox, cwd = 'workspace-write', os.path.join(run_dir, 'scratch', f'codex-{spec["job"]}')
        os.makedirs(cwd, exist_ok=True)

    out_path = os.path.join(jd, 'out.json')
    cmd = ['codex', 'exec']
    if thread:
        cmd.append('resume')
    cmd += ['--json', '-o', out_path, '--skip-git-repo-check', '-m', spec['model'],
            '-c', f'model_reasoning_effort="{spec["effort"]}"',
            '-c', f'sandbox_mode="{sandbox}"']
    if spec.get('pin'):
        cmd += ['-c', 'approval_policy="never"']
    if spec['schema']:
        cmd += ['--output-schema', os.path.join(jd, 'schema.json')]
    writable = spec['writable'] + seat_git_dirs(spec) if spec['sandbox'] == 'workspace-write' else []
    if writable:
        cmd += ['-c', 'sandbox_workspace_write.writable_roots=' + json.dumps(writable)]
    if thread:
        cmd.append(thread)
    else:
        cmd += ['-C', cwd]
    return cmd + ['-'], cwd


def run_codex_job(jd, spec):
    started = time.time()
    run_dir = spec['runDir']
    thread_file = os.path.join(run_dir, 'seats', spec['seat'], 'thread')
    thread = None if spec['fresh'] or not os.path.exists(thread_file) else read(thread_file).strip()

    out_path = os.path.join(jd, 'out.json')
    cmd, cwd = codex_command(jd, spec, thread)                # prompt on stdin — never leave stdin open

    events_path, err_path = os.path.join(jd, 'events.jsonl'), os.path.join(jd, 'stderr.txt')
    timed_out = False
    with open(os.path.join(jd, 'prompt.md'), 'rb') as stdin, open(events_path, 'w') as so, open(err_path, 'w') as se:
        p = subprocess.Popen(cmd, cwd=cwd, stdin=stdin, stdout=so, stderr=se, start_new_session=True, env=subject_environment(), close_fds=True)
        write(os.path.join(jd, 'codex.pid'), str(p.pid))
        try:
            code = p.wait(timeout=spec['timeout'])
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            code = p.wait()
            timed_out = True

    new_thread, usage, errors = None, {}, []
    for line in read(events_path).split('\n'):
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        t = ev.get('type')
        if t == 'thread.started':
            new_thread = ev.get('thread_id')
        elif t == 'turn.completed' and isinstance(ev.get('usage'), dict):
            usage = {k: v for k, v in ev['usage'].items() if isinstance(v, (int, float))}
        elif t in ('error', 'turn.failed'):
            errors.append(json.dumps(ev.get('error') or ev.get('message') or ev)[:500])
    if new_thread and not thread:
        write(thread_file, new_thread)
    if thread and new_thread and thread != new_thread:
        return {'status': 'error', 'error': f'codex did not resume thread {thread} (it started {new_thread})'}

    thread_total = usage
    usage = turn_usage(os.path.dirname(thread_file), thread or new_thread, thread_total)
    record_usage(run_dir, spec, usage, thread_total, started)

    if timed_out:
        return {'status': 'error', 'thread': thread or new_thread,
                'error': f'codex timed out after {spec["timeout"] // 60} min'}

    if code != 0 or not os.path.exists(out_path):
        stderr = read(err_path) if os.path.exists(err_path) else ''
        stderr = '\n'.join(l for l in stderr.split('\n') if 'Reading additional input from stdin' not in l)
        return {'status': 'error', 'thread': thread or new_thread,
                'error': (' | '.join(errors) or tail(stderr, 15) or f'codex exited {code}')[:2000]}
    raw = read(out_path)
    if not spec['schema']:
        result = raw
    else:
        try:
            result = json.loads(raw)
        except json.JSONDecodeError:
            return {'status': 'error', 'thread': thread or new_thread,
                    'error': 'codex final message was not valid JSON: ' + raw[:500]}
    return {'status': 'done', 'job': spec['job'], 'seat': spec['seat'], 'thread': thread or new_thread,
            'elapsedSec': round(time.time() - started, 1), 'usage': usage, 'result': result}


def fits_schema(schema, result):
    """Whether a structured output has this turn's shape. A resumed agy turn that answers in plain
    text leaves the previous turn's structured_output in place, still with status SUCCESS. Shape
    alone can't tell two debate rounds apart, so the workflow also pins a per-turn tag as a
    one-value enum (`turn`), and a top-level enum must hold."""
    props = schema.get('properties', {})
    return (isinstance(result, dict) and all(k in result for k in schema.get('required', []))
            and (schema.get('additionalProperties', True) is not False or set(result) <= set(props))
            and all(result.get(k) in p['enum'] for k, p in props.items()
                    if isinstance(p, dict) and 'enum' in p and k in result))


CLAUDE_HEADLESS = (
    'This is a headless factory turn: nobody can approve new permissions. Keep the existing permission controls. '
    'When Write/Edit and Bash are available, write probe source in your allowed workspace, then execute it in a separate Bash call. '
    'Use one simple operation per command; avoid combining source heredocs, execution, pipelines and unrelated checks. '
    'Edit files with Edit, not sed -i, perl -pi or Python heredocs (python3 - <<EOF). Use Write for new files. '
    'Do not use background jobs or sleep polling. Run commands in the foreground; use the helper wait command for its running jobs. '
    'If a tool is denied, do not bypass the restriction. Continue with permitted work and explicitly report '
    'the denied check and any missing evidence in your answer. Never claim that an unrun check passed. '
    'Finish in the requested output format even when an optional probe was denied.'
)


def claude_tmp_dir(spec):
    """A writable cache directory for one Claude job. Tools that default to ~/.cache (Psalm,
    pip) are otherwise denied by the sandbox. TMPDIR isn't set: Claude's Bash sandbox replaces it
    with its own writable temp directory."""
    return os.path.join(spec['runDir'], 'tmp', f'claude-{spec["job"]}')


def claude_env(spec):
    cache = os.path.join(claude_tmp_dir(spec), 'cache')
    os.makedirs(cache, exist_ok=True)
    # Worktrees share project auto-memory. Disable it for this process, including resumes.
    # https://code.claude.com/docs/en/memory#enable-or-disable-auto-memory
    return {**subject_environment(), 'XDG_CACHE_HOME': cache, 'CLAUDE_CODE_DISABLE_AUTO_MEMORY': '1'}


def claude_command(jd, spec, session):
    """One headless Claude turn, with explicit workspace access and no permission bypass.

    Read-only reviewers have no shell or edit tools. Implementers can edit their working
    directories and run commands in Claude's Bash sandbox; an action requiring a new approval
    is denied and surfaced by run_claude_job. Existing managed/user deny rules still apply.
    """
    effort = 'max' if spec['effort'] == 'ultra' else spec['effort']
    if effort not in ('low', 'medium', 'high', 'xhigh', 'max'):
        raise CouncilError(f'unsupported Claude effort: {spec["effort"]}')
    readonly = spec['sandbox'] == 'read-only'
    cmd = ['claude', '--print', '--output-format', 'json', '--model', spec['model'], '--effort', effort,
           '--permission-mode', 'plan' if readonly else 'acceptEdits', '--permission-prompts', 'none',
           '--append-system-prompt', CLAUDE_HEADLESS,
           '--tools', 'Read,Glob,Grep' if readonly else 'Bash,Read,Glob,Grep,Edit,Write']
    # The run's reference files and its room (the diffs, stats and posts a prompt names) are
    # readable for every seat, including a reviewer whose cwd is a snapshot checkout outside the
    # room. A permission rule rather than --add-dir, which under acceptEdits would also make them
    # editable. Seats that may write to the room get it as a writable root below.
    settings = {'permissions': {'allow': [f'Read(/{os.path.join(spec["runDir"], d)}/**)' for d in ('refs', 'room')]}}
    if not readonly:
        roots = list(dict.fromkeys(spec['writable'] + seat_git_dirs(spec) + [claude_tmp_dir(spec)]))
        for root in roots:
            cmd += ['--add-dir', root]
        settings['sandbox'] = {
            'enabled': True, 'failIfUnavailable': True,
            'autoAllowBashIfSandboxed': True, 'allowUnsandboxedCommands': False,
            'filesystem': {'disabled': False, 'allowWrite': roots},
        }
    if spec.get('pin'):
        guard = shlex.join(['node', os.path.join(spec['pin']['root'], 'lib', 'engine.mjs'), 'hook', os.path.join(jd, 'spec.json')]) + ' || exit 2'
        settings['statusLine'] = {'type': 'command', 'command': 'true'}
        settings['hooks'] = {
            'PreToolUse': [{'matcher': 'Bash|Edit|Write', 'hooks': [{'type': 'command', 'command': guard}]}],
            'ConfigChange': [{'hooks': [{'type': 'command', 'command': guard}]}],
        }
        cmd += ['--disable-slash-commands', '--strict-mcp-config', '--mcp-config', '{"mcpServers":{}}']
    cmd += ['--settings', json.dumps(settings)]
    if spec['schema']:
        cmd += ['--json-schema', read(os.path.join(jd, 'schema.json'))]
    if session:
        cmd += ['--resume', session]
    return cmd, spec['cwd']


def claude_usage_total(seat_dir, session, usage):
    """Claude's result usage is per invocation. Keep a separate accumulated session total."""
    path = os.path.join(seat_dir, 'claude-usage-total.json')
    previous = {}
    if os.path.exists(path):
        rec = json.loads(read(path))
        if rec.get('session') == session:
            previous = rec.get('usage', {})
    total = dict(previous)
    for key, value in usage.items():
        total[key] = total.get(key, 0) + value
    if session:
        write_json(path, {'session': session, 'usage': total})
    return total


def run_claude_job(jd, spec):
    """Drive Claude directly from prompt.md; its JSON envelope is never the model's result."""
    started = time.time()
    seat_dir = os.path.join(spec['runDir'], 'seats', spec['seat'])
    session_file = os.path.join(seat_dir, 'claude-session')
    session = None if spec['fresh'] or not os.path.exists(session_file) else read(session_file).strip()
    cmd, cwd = claude_command(jd, spec, session)
    if not session:
        # Allocate before launch: JSON output may never arrive if the turn times out.
        session = str(uuid.uuid4())
        cmd += ['--session-id', session]
    out_path, err_path = os.path.join(jd, 'out.json'), os.path.join(jd, 'stderr.txt')
    with open(os.path.join(jd, 'prompt.md'), 'rb') as stdin, open(out_path, 'w') as so, open(err_path, 'w') as se:
        p = subprocess.Popen(cmd, cwd=cwd, stdin=stdin, stdout=so, stderr=se, start_new_session=True,
                             env=claude_env(spec), close_fds=True)
        write(os.path.join(jd, 'claude.pid'), str(p.pid))
        try:
            code = p.wait(timeout=spec['timeout'])
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            p.wait()
            write(session_file, session)
            return {'status': 'error', 'thread': session, 'error': f'claude timed out after {spec["timeout"] // 60} min'}
    stderr = read(err_path)
    try:
        out = json.loads(read(out_path))
    except (ValueError, OSError):
        return {'status': 'error', 'thread': session, 'error': (tail(stderr, 15) or f'claude exited {code} with no valid JSON')[:2000]}
    if not isinstance(out, dict):
        return {'status': 'error', 'thread': session, 'error': 'claude returned an invalid result envelope'}
    # Denials describe tool attempts, not the outcome of the entire turn. Keep the raw
    # commands in out.json and carry a compact diagnostic through validation and reporting.
    denials = out.get('permission_denials') or []
    diagnostics = {'permissionDenials': {
        'count': len(denials),
        'tools': list(dict.fromkeys(str(d.get('tool_name', '?')) if isinstance(d, dict) else '?' for d in denials)),
        'source': out_path,
    }} if denials else {}

    def failed(message):
        return {'status': 'error', 'thread': session, 'error': message, **diagnostics}

    new_session = out.get('session_id') if isinstance(out.get('session_id'), str) else None
    if session and new_session and session != new_session:
        return {**failed(f'claude did not resume session {session} (it started {new_session}): the seat lost its memory'), 'thread': None}
    if new_session:
        write(session_file, new_session)
    reported = out.get('usage') if isinstance(out.get('usage'), dict) else {}
    usage = {k: v for k, v in reported.items() if isinstance(v, (int, float)) and not isinstance(v, bool)}
    total = claude_usage_total(seat_dir, session, usage)
    record_usage(spec['runDir'], spec, usage, total, started)
    if code != 0 or out.get('is_error') or out.get('subtype') not in (None, 'success'):
        errors = out.get('errors') or out.get('result') or stderr or f'claude exited {code}'
        return failed(oneline(errors, 2000))
    if out.get('terminal_reason') not in (None, 'completed') or (denials and out.get('subtype') != 'success'):
        return failed(f'claude did not complete the turn (terminal_reason={out.get("terminal_reason")}, subtype={out.get("subtype")})')
    if not new_session:
        return failed('claude returned no session_id; the seat cannot retain its memory')
    result = out.get('structured_output') if spec['schema'] else out.get('result')
    if spec['schema']:
        schema = json.loads(read(os.path.join(jd, 'schema.json')))
        if not fits_schema(schema, result):
            return failed('claude returned structured output that does not match this turn\'s schema')
    elif result is None or result == '':
        return failed('claude returned no result')
    return {'status': 'done', 'job': spec['job'], 'seat': spec['seat'], 'thread': session,
            'elapsedSec': round(time.time() - started, 1), 'usage': usage, 'result': result, **diagnostics}


def run_gemini_job(jd, spec):
    """One agy turn. agy reports SUCCESS with exit 0 in several failures (a tool it couldn't ask
    about was denied and ended the turn, an unknown conversation id silently started a new one, a
    resumed turn answered in text and the previous turn's structured output came back), so every
    result is checked here rather than trusted."""
    started = time.time()
    run_dir = spec['runDir']
    seat_dir = os.path.join(run_dir, 'seats', spec['seat'])
    conv_file = os.path.join(seat_dir, 'conversation')
    conv = None if spec['fresh'] or not os.path.exists(conv_file) else read(conv_file).strip()

    # Where agy starts decides what its sandbox lets shell commands touch: nothing under the start
    # directory can be written, even with a grant, and from anywhere inside the repository nothing
    # under .council can even be read. So it starts in an empty directory outside the repository,
    # and the prompt names the worktree by absolute path; the grant on <repo>/.council (added by
    # seat-run) covers the worktrees and the room.
    run_tag = f"{os.path.basename(run_dir)}-{prompt_hash(run_dir).split('-')[1]}"
    cwd = os.path.join(tempfile.gettempdir(), 'council-agy', run_tag, re.sub(r'[^A-Za-z0-9._-]', '-', spec['seat']))
    os.makedirs(cwd, exist_ok=True)

    schema = json.loads(read(os.path.join(jd, 'schema.json'))) if spec['schema'] else None
    out_path, err_path = os.path.join(jd, 'out.json'), os.path.join(jd, 'stderr.txt')

    def call(prompt, conversation):
        cmd = ['agy', '-p', prompt, '--model', spec['model'], '--output-format', 'json', '--sandbox']
        if schema is not None:
            cmd += ['--json-schema', os.path.join(jd, 'schema.json')]
        if conversation:
            cmd += ['--conversation', conversation]
        with open(out_path, 'w') as so, open(err_path, 'a') as se:
            p = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=so, stderr=se, start_new_session=True, env=subject_environment(), close_fds=True)
            write(os.path.join(jd, 'agy.pid'), str(p.pid))
            try:
                code = p.wait(timeout=max(60, spec['timeout'] - (time.time() - started)))
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(p.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                p.wait()
                return None, f'agy timed out after {spec["timeout"] // 60} min'
        try:
            return json.loads(read(out_path)), None
        except (json.JSONDecodeError, OSError):
            return None, (tail(read(err_path), 15) or f'agy exited {code} with no JSON')

    def fits(result):
        return fits_schema(schema, result)

    out, err = call(read(os.path.join(jd, 'prompt.md')), conv)
    if out is None:
        return {'status': 'error', 'thread': conv, 'error': err[:2000]}
    new_conv = out.get('conversation_id') or None
    if new_conv and conv and new_conv != conv:
        return {'status': 'error', 'error': f'agy did not resume conversation {conv} (it started {new_conv}): '
                f'the seat lost its memory. {tail(read(err_path), 5)}'[:2000]}
    if new_conv and not conv:
        write(conv_file, new_conv)
    thread = conv or new_conv

    # A permission request ends a headless turn, but the conversation keeps its work: the seat asked
    # to run a command outside the sandbox (git, which can't read the repository's data from inside
    # it). Resume once, saying so, rather than lose the seat.
    resumed = ''
    if out.get('status') == 'SUCCESS' and out.get('denied_actions') and thread and not spec.get('resumeSession'):
        resumed = ', '.join(d.get('action', '?') for d in out['denied_actions'])
        write(os.path.join(jd, 'out-denied.json'), json.dumps(out))
        out, err = call(DENIED_NUDGE.format(denied=resumed), thread)
        if out is None:
            return {'status': 'error', 'error': f'agy denied {resumed}, and resuming after it failed: {err}'[:2000]}
    nudged = False
    if (schema is not None and out.get('status') == 'SUCCESS' and not out.get('denied_actions')
            and not fits(out.get('structured_output')) and thread and not spec.get('resumeSession')):
        nudged = True
        write(os.path.join(jd, 'out-first.json'), json.dumps(out))
        out, err = call('You answered in text, not as structured output. Return your answer to my previous '
                        'message now as structured output that matches the JSON schema. Change nothing else.', thread)
        if out is None:
            return {'status': 'error', 'error': err[:2000]}

    reported = {k: v for k, v in (out.get('usage') or {}).items() if isinstance(v, (int, float))}
    usage = turn_usage(seat_dir, thread, reported)
    record_usage(run_dir, spec, usage, reported, started)

    stderr = read(err_path) if os.path.exists(err_path) else ''
    if out.get('status') != 'SUCCESS':
        return {'status': 'error', 'error': (out.get('error') or tail(stderr, 15) or f'agy status {out.get("status")}')[:2000]}
    denied = ', '.join(d.get('action', '?') for d in out.get('denied_actions') or [])
    result = out.get('structured_output') if schema is not None else out.get('response')
    if schema is not None and result is not None and not fits(result):
        return {'status': 'error', 'error': 'agy returned structured output that does not match this turn\'s schema'
                + (' (also after a follow-up asking for it)' if nudged else '') + f'. Its text: {oneline(out.get("response"))}'[:2000]}
    if result is None or result == '':
        why = (f'agy denied {denied}, which ended the turn early' + (' (also after resuming once)' if resumed else '') if denied
               else 'agy returned no output' + (' (no structured_output)' if schema is not None else ''))
        return {'status': 'error', 'error': f'{why}. {tail(stderr, 5)}'.strip()[:2000]}
    return {'status': 'done', 'job': spec['job'], 'seat': spec['seat'], 'thread': thread,
            'elapsedSec': round(time.time() - started, 1), 'usage': usage, 'result': result,
            **({'denied': denied} if denied else {}), **({'resumedAfter': resumed} if resumed else {}),
            **({'nudged': True} if nudged else {})}


DENIED_NUDGE = ('Your last request ({denied}) needed a permission that nobody can grant in this run, so it was denied and your turn '
                'stopped there. Your work so far is kept. Don\'t ask to run anything outside the sandbox again: git commands fail '
                'inside it, so read and compare files directly. Carry on with the task from where you stopped, and finish as the '
                'task asks, with your answer as structured output if it asks for one.')


def oneline(text, n=300):
    text = ' '.join(str(text or '').split())
    return text if len(text) <= n else text[:n] + ' […]'


# ---------------------------------------------------------------- snapshots and measurement

def parse_numstat(text):
    """(files, added, removed) from `git diff --numstat` output; binary files ('-') count as no lines."""
    files, added, removed = [], 0, 0
    for line in text.split('\n'):
        parts = line.split('\t')
        if len(parts) == 3:
            files.append(parts[2])
            added += int(parts[0]) if parts[0].isdigit() else 0
            removed += int(parts[1]) if parts[1].isdigit() else 0
    return files, added, removed


def numstat(wt, a, b):
    return parse_numstat(git('diff', '--numstat', a, b, cwd=wt))


def worktree_tree(run, wt, index_name, base=None):
    """The tree object for a worktree's current files (tracked or not, minus SNAPSHOT_EXCLUDES; a
    file committed on `base` is kept), written through a throwaway index so the worktree's own
    index is never touched."""
    idx = os.path.join(run['runDir'], 'tmp', index_name)
    excludes = os.path.join(run['runDir'], 'tmp', 'snapshot-excludes')
    if not os.path.exists(excludes):
        write(excludes, '\n'.join(SNAPSHOT_EXCLUDES) + '\n')
    env = dict(os.environ, GIT_INDEX_FILE=idx)
    if os.path.exists(idx):
        os.remove(idx)
    try:
        git('read-tree', base or run['head'], cwd=wt, env=env)
        git('-c', f'core.excludesFile={excludes}', 'add', '-A', cwd=wt, env=env)
        return git('write-tree', cwd=wt, env=env).strip()
    finally:
        if os.path.exists(idx):
            os.remove(idx)


def seat_head(run, wt):
    """The worktree's HEAD when it is the base commit or a descendant of it (the seat committed
    there); otherwise the base commit, so a seat that moved HEAD elsewhere is still measured
    against the base."""
    head = git('rev-parse', '--verify', '--quiet', 'HEAD', cwd=wt, check=False).strip()
    if head and subprocess.run(['git', 'merge-base', '--is-ancestor', run['head'], head], cwd=wt,
                               stdin=subprocess.DEVNULL, capture_output=True, close_fds=True).returncode == 0:
        return head
    return run['head']


def snapshot(run, seat, label, path=None, since=None):
    """Record the seat's current tree as a commit under refs/council/<run>/<seat>-<label>, and
    write to room/<label>/: <seat>.diff against the base commit, <seat>.stat (per-file counts),
    and, with `since`, <seat>.delta.diff against the seat's <since> snapshot, so readers can see
    what changed since they last looked. Uses a throwaway index, so the worktree's own index is
    never touched. Commits the seat made on top of the base commit are kept: the snapshot is the
    seat's HEAD, plus one council commit on top for whatever it left uncommitted."""
    wt = path or seat_tree(run, seat)
    base = seat_head(run, wt)
    tree = worktree_tree(run, wt, f'index-{seat}-{label}', base)
    if base != run['head'] and tree == git('rev-parse', f'{base}^{{tree}}', cwd=wt).strip():
        commit = base
    else:
        ident = dict(os.environ, GIT_AUTHOR_NAME='council', GIT_AUTHOR_EMAIL='council@localhost',
                     GIT_COMMITTER_NAME='council', GIT_COMMITTER_EMAIL='council@localhost')
        message = f'council {run["runId"]} {seat} {label}' + ('' if base == run['head'] else ': uncommitted changes')
        commit = git('commit-tree', tree, '-p', base, '-m', message, cwd=wt, env=ident).strip()
    ref = f'refs/council/{run["runId"]}/{seat}-{label}'
    git('update-ref', ref, commit, cwd=wt)
    diff_path = os.path.join(run['room'], label, f'{seat}.diff')
    write(diff_path, git('diff', '--binary', run['head'], commit, cwd=wt))
    stat_path = os.path.join(run['room'], label, f'{seat}.stat')
    write(stat_path, git('diff', '--stat=200,160', run['head'], commit, cwd=wt))
    files, added, removed = numstat(wt, run['head'], commit)
    out = {'ref': ref, 'commit': commit, 'tree': tree, 'diff': diff_path, 'stat': stat_path, 'files': len(files),
           'fileList': files[:50], 'added': added, 'removed': removed, 'delta': None,
           'seatCommits': int(git('rev-list', '--count', f'{run["head"]}..{base}', cwd=wt).strip())}
    prev = since and git('rev-parse', '--verify', '--quiet', f'refs/council/{run["runId"]}/{seat}-{since}',
                         cwd=wt, check=False).strip()
    if prev:
        delta_path = os.path.join(run['room'], label, f'{seat}.delta.diff')
        write(delta_path, git('diff', '--binary', prev, commit, cwd=wt))
        dfiles, dadded, dremoved = numstat(wt, prev, commit)
        out['delta'] = {'since': since, 'diff': delta_path, 'files': len(dfiles), 'added': dadded, 'removed': dremoved}
    return out


def verification_config(run):
    path = os.path.join(run['runDir'], 'verification.json')
    config = json.loads(read(path)) if os.path.exists(path) else {'env': {}}
    if not isinstance(config, dict) or 'env' not in config or not set(config) <= {'env', 'concurrency'} or not isinstance(config['env'], dict):
        raise CouncilError('verification.json must contain an env object and optionally concurrency')
    if 'concurrency' in config and (type(config['concurrency']) is not int or not 1 <= config['concurrency'] <= 64):
        raise CouncilError('verification concurrency must be an integer from 1 to 64')
    return config


def verification_concurrency(run):
    """How many replay executions (and the suite beside them) run at once. 1 is fully serial, for
    tests that share a fixed port, database or global cache."""
    return verification_config(run).get('concurrency', min(4, max(1, (os.cpu_count() or 2) // 2)))


def verification_settings(run):
    """Capture only explicit run overrides, never serialize the caller's environment."""
    path = os.path.join(run['runDir'], 'verification.json')
    config = verification_config(run)
    for key, value in config['env'].items():
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key) or not isinstance(value, str) or '\0' in value:
            raise CouncilError('verification env requires valid variable names and string values without NUL')
    verify = os.path.join(run['runDir'], 'verify.sh')
    return {'command': read(verify).strip() if os.path.exists(verify) else '', 'env': config['env'],
            **({'baseEnv': run['verificationBaseEnv']} if run.get('factory') else {})}


def verification_environment(settings):
    env = dict(settings.get('baseEnv', os.environ))
    pin = os.environ.get('DARK_FACTORY_PIN')
    if pin and 'PATH' in env:
        # A pinned gate tests the candidate, so it must not resolve the frozen export's helpers.
        frozen = os.path.realpath(os.path.join(json.loads(pin)['root'], 'bin'))
        env['PATH'] = os.pathsep.join(e for e in env['PATH'].split(os.pathsep) if not os.path.isabs(e) or os.path.realpath(e) != frozen)
    return subject_environment(dict(env, **settings['env']))


class VerificationInfrastructureError(CouncilError):
    pass


@contextmanager
def verification_temp(run, settings):
    env = verification_environment(settings)
    if not run.get('factory'):
        yield env
        return
    # Prefer short roots for Unix sockets, but probe creation rather than assuming
    # /tmp is writable inside every host sandbox. Never clean another job's files.
    candidates = []
    for source in (settings['env'], os.environ, env, {'TMPDIR': '/tmp', 'TMP': '/var/tmp'}):
        for key in ('TMPDIR', 'TMP', 'TEMP'):
            root = source.get(key)
            if root and os.path.isabs(root) and root not in candidates:
                candidates.append(root)
    candidates.sort(key=lambda root: len(os.fsencode(os.path.realpath(root))) > 40)
    failures = []
    for root in candidates:
        try:
            temporary = tempfile.TemporaryDirectory(prefix='df-', dir=root)
        except OSError as error:
            failures.append(f'{root}: {error.strerror or error}')
            continue
        with temporary as directory:
            yield dict(env, TMPDIR=directory, TMP=directory, TEMP=directory)
        return
    raise VerificationInfrastructureError('No writable verification temporary root: ' + '; '.join(failures))


def verification_infrastructure_failure(result, env):
    if result['exitCode'] == 0 or result['timedOut']:
        return False
    # Require an exception diagnostic referencing this execution's private temp
    # directory. A test mentioning socket limits is not an infrastructure failure.
    roots = {env['TMPDIR'], os.path.realpath(env['TMPDIR'])}
    for line in read(result['log']).splitlines():
        if not any(root.rstrip('/') + '/' in line for root in roots):
            continue
        if re.match(r'^(?:PHP Fatal error:\s*)?(?:Uncaught\s+)?[\w\\]*SocketException:\s+Could not create server unix://', line):
            return True
        if re.match(r'^OSError:\s+(?:\[Errno \d+\] )?(?:AF_UNIX path too long|sun_path exceeds (?:the )?limit)', line):
            return True
    return False


def suite(run, cwd, label, seat, timeout, settings=None):
    settings = verification_settings(run) if settings is None else settings
    if not settings['command']:
        return {'ran': False, 'passed': False, 'note': 'no verification command configured'}
    log = os.path.join(run['runDir'], 'logs', f'suite-{seat}-{label}.log')
    attempts, started = [], time.monotonic()
    original = git('diff', '--binary', 'HEAD', cwd=cwd) if run.get('factory') else None
    for attempt in range(2 if run.get('factory') else 1):
        attempt_log = log if attempt == 0 else log + '.retry'
        try:
            with verification_temp(run, settings) as env:
                r = run_shell(settings['command'], cwd, max(0.01, timeout - (time.monotonic() - started)), attempt_log, env=env)
                infrastructure = run.get('factory') and verification_infrastructure_failure(r, env)
                attempts.append(dict(r, env={**settings['env'], **{k: env[k] for k in ('TMPDIR', 'TMP', 'TEMP') if k in env}},
                                     failureKind='infrastructure' if infrastructure else ''))
        except VerificationInfrastructureError as error:
            write(attempt_log, str(error) + '\n')
            return dict(ran=False, passed=False, cwd=cwd, command=settings['command'], env=settings['env'],
                        log=attempt_log, tail=str(error), attempts=attempts, failureKind='infrastructure')
        if not infrastructure or time.monotonic() - started >= timeout or git('diff', '--binary', 'HEAD', cwd=cwd) != original:
            break
    return dict(r, ran=True, passed=(r['exitCode'] == 0 and not r['timedOut']),
                cwd=cwd, command=settings['command'], env=settings['env'],
                **({'attempts': attempts, 'failureKind': 'infrastructure' if infrastructure else ''} if run.get('factory') else {}))


def safe_relative(root, rel):
    """Artifact paths are relative, confined, and may not follow symlinks."""
    if not isinstance(rel, str) or not rel or os.path.isabs(rel) or any(p in ('', '.', '..') for p in rel.split('/')):
        raise CouncilError(f'invalid relative artifact path: {rel!r}')
    root = os.path.realpath(root)
    path = os.path.join(root, rel)
    if os.path.commonpath([root, os.path.realpath(path)]) != root:
        raise CouncilError(f'artifact escapes its directory: {rel}')
    part = root
    for name in rel.split('/'):
        part = os.path.join(part, name)
        if os.path.islink(part):
            raise CouncilError(f'artifact is a symlink: {rel}')
    return path


def file_sha256(path):
    with open(path, 'rb') as f:
        return hashlib.file_digest(f, 'sha256').hexdigest() if hasattr(hashlib, 'file_digest') else hashlib.sha256(f.read()).hexdigest()


def evidence_inputs(run, seat):
    root = safe_relative(run['runDir'], f'room/evidence/{seat}')
    manifest = os.path.join(root, 'manifest.json')
    if not os.path.exists(manifest):
        return []
    data = json.loads(read(safe_relative(root, 'manifest.json')))
    if not isinstance(data, list):
        raise CouncilError('evidence manifest must be an array of {path, criterion, stage} records')
    records, seen = [], set()
    for item in data:
        if not isinstance(item, dict) or set(item) != {'path', 'criterion', 'stage'}:
            raise CouncilError('each evidence entry requires path, criterion and stage')
        if not all(isinstance(item[k], str) and item[k].strip() for k in item):
            raise CouncilError('evidence entry values must be nonempty strings')
        path = safe_relative(root, item['path'])
        if item['path'] in seen or item['path'] == 'manifest.json' or not os.path.isfile(path):
            raise CouncilError(f'duplicate, reserved or missing evidence file: {item["path"]}')
        seen.add(item['path'])
        records.append(dict(item, sha256=file_sha256(path)))
    return records


def publish_evidence(run, seat, label, measurement):
    """Freeze raw artifacts separately from the room's arguments, bound to a measured tree."""
    records = evidence_inputs(run, seat)
    index = {'snapshot': measurement['snapshot']['commit'], 'tree': measurement['snapshot']['tree'],
             'verification': measurement['verification'],
             'suite': measurement['suite'], 'artifacts': records}
    log = measurement['suite'].get('log')
    if log:
        index['suiteLogSha256'] = file_sha256(log)
    # Content-addressed bundles are never overwritten on remeasurement of the same label.
    digest = hashlib.sha256(json.dumps(index, sort_keys=True).encode()).hexdigest()
    rel = f'evidence/{seat}-{label}-{digest}'
    target = safe_relative(run['runDir'], rel)
    if not os.path.exists(target):
        os.makedirs(os.path.dirname(target), exist_ok=True)
        staging = tempfile.mkdtemp(prefix='.publish-', dir=os.path.dirname(target))
        try:
            for item in records:
                src = safe_relative(os.path.join(run['room'], 'evidence', seat), item['path'])
                dst = safe_relative(staging, 'files/' + item['path'])
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copyfile(src, dst)
                if file_sha256(dst) != item['sha256']:
                    raise CouncilError('evidence changed while being published')
            if log:
                shutil.copyfile(log, os.path.join(staging, 'suite.log'))
                if file_sha256(os.path.join(staging, 'suite.log')) != index['suiteLogSha256']:
                    raise CouncilError('verification log changed while being published')
            write_json(os.path.join(staging, 'index.json'), index)
            os.rename(staging, target)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
    elif json.loads(read(safe_relative(target, 'index.json'))) != index:
        raise CouncilError('published evidence index was modified')
    pointer = os.path.join(run['runDir'], 'evidence', f'{seat}-{label}.json')
    write_json(pointer, {'index': rel + '/index.json', 'sha256': file_sha256(os.path.join(target, 'index.json'))})
    return {'status': 'published', 'index': os.path.join(target, 'index.json'), 'pointer': pointer}


def run_verify_job(jd, spec):
    run = load_run(spec['runDir'])
    return {'status': 'done', 'job': spec['job'],
            'suite': suite(run, spec['path'], spec['label'], 'verify', spec['suiteTimeout'], spec['verification'])}


def inspect_evidence(run, seat, label):
    pointer = json.loads(read(safe_relative(run['runDir'], f'evidence/{seat}-{label}.json')))
    index_path = safe_relative(run['runDir'], pointer['index'])
    if file_sha256(index_path) != pointer['sha256']:
        raise CouncilError('evidence index hash mismatch')
    index = json.loads(read(index_path))
    ref = f'refs/council/{run["runId"]}/{seat}-{label}'
    if index['snapshot'] != git('rev-parse', ref, cwd=run['repoRoot']).strip():
        raise CouncilError('evidence does not describe the current snapshot')
    if index['verification'] != verification_settings(run):
        raise CouncilError('verification settings changed since the snapshot was measured')
    root = os.path.dirname(index_path)
    for item in index['artifacts']:
        if file_sha256(safe_relative(root, 'files/' + item['path'])) != item['sha256']:
            raise CouncilError(f'evidence file hash mismatch: {item["path"]}')
    if index.get('suiteLogSha256') and file_sha256(safe_relative(root, 'suite.log')) != index['suiteLogSha256']:
        raise CouncilError('evidence suite log hash mismatch')
    return {'status': 'ok', 'index': index_path, 'snapshot': index['snapshot'], 'artifacts': index['artifacts']}


def cmd_evidence(a):
    emit(inspect_evidence(load_run(a.run_dir), a.seat, a.label))


def cmd_verify(a):
    run = load_run(a.run_dir)
    key = f'verify-{a.label}'
    jd = job_dir(a.run_dir, key)
    settings = verification_settings(run)
    if a.command_file:
        settings['command'] = read(a.command_file).strip()
    path = os.path.realpath(a.path)
    spec = {'kind': 'verify', 'runDir': run['runDir'], 'job': key, 'label': a.label,
            'path': path, 'verification': settings, 'suiteTimeout': a.suite_timeout}
    # Mutable checkouts are always rerun; only join a currently running identical request.
    def decide(old, state):
        if state and state.get('status') == 'running':
            if old != spec:
                raise CouncilError('verification job is running with different inputs; use a new label')
            return 'wait'
        return None
    if settle_existing_job(jd, key, a.max_wait, decide):
        return
    start_job(jd, spec)
    emit(wait_job(jd, key, a.max_wait))


def crosstest(run, cwd, label, seat, test_ids, timeout, reset=False, env=None):
    """Copy each published test's files into cwd, run it, and remove them again. With `reset` (a
    scratch checkout), tracked files a test changed are restored before the next one runs."""
    results = []
    for tid in test_ids:
        tdir = os.path.join(run['room'], 'tests', tid)
        meta_path = os.path.join(tdir, 'test.json')
        if not os.path.exists(meta_path):
            results.append({'test': tid, 'outcome': 'error', 'note': 'missing test.json'})
            continue
        try:
            meta = json.loads(read(meta_path))
            command = str(meta['command'])
        except (json.JSONDecodeError, KeyError) as e:
            results.append({'test': tid, 'outcome': 'error', 'note': f'bad test.json: {e}'})
            continue
        files_root = os.path.join(tdir, 'files')
        rels = []
        for base, _, names in os.walk(files_root):
            for n in names:
                rels.append(os.path.relpath(os.path.join(base, n), files_root))
        copied, made_dirs, conflict = [], [], None
        for rel in rels:
            src, dst = os.path.join(files_root, rel), os.path.join(cwd, rel)
            if os.path.exists(dst):
                with open(src, 'rb') as f1, open(dst, 'rb') as f2:
                    if f1.read() == f2.read():
                        continue                          # already there, identical: run in place
                conflict = rel
                break
            d = os.path.dirname(dst)
            missing = []
            while d and not os.path.exists(d):
                missing.append(d)
                d = os.path.dirname(d)
            for m in reversed(missing):
                os.makedirs(m, exist_ok=True)
                made_dirs.append(m)
            shutil.copy2(src, dst)
            copied.append(dst)
        if conflict:
            results.append({'test': tid, 'outcome': 'conflict', 'note': f'{conflict} already exists with different content'})
        else:
            log = os.path.join(run['runDir'], 'logs', f'cross-{tid}-on-{seat}-{label}.log')
            r = run_shell(command, cwd, timeout, log, env=env)
            outcome = 'pass' if r['exitCode'] == 0 and not r['timedOut'] else 'fail'
            results.append({'test': tid, 'outcome': outcome, 'exitCode': r['exitCode'],
                            'timedOut': r['timedOut'], 'tail': tail(r['tail'], 12)})
        for f in copied:
            try:
                os.remove(f)
            except FileNotFoundError:
                pass
        for d in reversed(made_dirs):
            try:
                os.rmdir(d)
            except OSError:
                pass
        if reset:
            mutated = tracked_changes(cwd)
            if mutated:
                results[-1]['mutated'] = mutated[:20]
                git('checkout', '-q', '--', '.', cwd=cwd, check=False)
    return results


# Concurrent replays share one repository's worktree metadata; Git locks it per command.
WORKTREE_LOCK = threading.Lock()


def scratch_checkout(run, seat, label, commit, live):
    """A disposable checkout of a snapshot commit, where the suite and the cross-tests run: the
    seat's live worktree can change while they run (or a test can change it), and then the result
    would describe bytes nobody snapshotted. Dependencies are cloned from the live worktree, so a
    dependency the seat installed is there too. Returns (path, error)."""
    path = os.path.join(run['runDir'], 'scratch', f'{seat}-{label}-{os.getpid()}')
    try:
        shutil.rmtree(path, ignore_errors=True)
        detached_checkout(run, path, commit)
        clone_deps(live, path)
        if run.get('factory'):
            copy_agent_docs(run['repoRoot'], path, untracked=True)
        return path, None
    except (CouncilError, OSError, subprocess.CalledProcessError) as e:
        drop_checkout(run, path)
        return None, oneline(str(e), 300)


def detached_checkout(run, path, commit):
    """Check `commit` out at `path` as a git worktree, or, where the worktree records can't be
    written, as a standalone repository that borrows the main repository's objects.

    A sandbox (Claude Code's Bash tool's among them) can refuse `git worktree add` with "could not
    create directory of '.git/worktrees/…'" while allowing writes to the run directory. The
    fallback writes nothing under the repository's .git: its git dir is <path>.gitdir, beside the
    checkout, and its objects come from the main repository through objects/info/alternates. Git
    commands in the checkout (status, diff, checkout -- .) still work. Returns 'worktree' or
    'standalone'."""
    root = run['repoRoot']
    with WORKTREE_LOCK:
        try:
            git('worktree', 'add', '--detach', path, commit, cwd=root)
            return 'worktree'
        except CouncilError as e:
            refused = e
            git('worktree', 'prune', cwd=root, check=False)
    gitdir = path + '.gitdir'
    shutil.rmtree(path, ignore_errors=True)
    shutil.rmtree(gitdir, ignore_errors=True)
    common = os.path.normpath(os.path.join(root, git('rev-parse', '--git-common-dir', cwd=root).strip()))
    sha = git('rev-parse', '--verify', f'{commit}^{{commit}}', cwd=root).strip()
    try:
        os.makedirs(path)
        git('init', '-q', f'--separate-git-dir={gitdir}', path)
        with open(os.path.join(gitdir, 'objects', 'info', 'alternates'), 'w', encoding='utf-8') as f:
            f.write(os.path.join(common, 'objects') + '\n')
        git('checkout', '-q', '--detach', sha, cwd=path)
    except (CouncilError, OSError) as e:
        shutil.rmtree(path, ignore_errors=True)
        shutil.rmtree(gitdir, ignore_errors=True)
        raise CouncilError(f'{refused}; standalone checkout also failed: {e}')
    return 'standalone'


def drop_checkout(run, path):
    with WORKTREE_LOCK:
        if not os.path.isdir(path + '.gitdir'):
            git('worktree', 'remove', '--force', path, cwd=run['repoRoot'], check=False)
    shutil.rmtree(path, ignore_errors=True)
    shutil.rmtree(path + '.gitdir', ignore_errors=True)


def tracked_changes(path):
    """Tracked files a command changed in a scratch checkout. Ignored outputs (caches, builds) don't count."""
    return [l[3:] for l in git('status', '--porcelain', '--untracked-files=no', cwd=path).split('\n') if l]


def replay_request(value):
    """Structural validation only; paths are independently checked against Git trees below."""
    if not isinstance(value, dict) or set(value) != {'testRoots', 'mapping'}:
        raise CouncilError('replay requires testRoots and mapping')
    if not isinstance(value['testRoots'], list) or any(not isinstance(p, str) for p in value['testRoots']):
        raise CouncilError('replay testRoots must be strings')
    if not isinstance(value['mapping'], list):
        raise CouncilError('replay mapping must be an array')
    for entry in value['mapping']:
        if not isinstance(entry, dict) or set(entry) != {'file', 'command', 'checkIds', 'fixtures'}:
            raise CouncilError('replay entries require file, command, checkIds and fixtures')
        if any(not isinstance(entry[k], str) or not entry[k].strip() or '\0' in entry[k] for k in ('file', 'command')):
            raise CouncilError('replay requires a nonempty file and command without NUL')
        for key in ('checkIds', 'fixtures'):
            if not isinstance(entry[key], list) or any(not isinstance(v, str) for v in entry[key]):
                raise CouncilError(f'replay {key} must be strings')
        if not entry['checkIds'] or len(set(entry['checkIds'])) != len(entry['checkIds']):
            raise CouncilError('replay requires distinct check IDs per command')
    return value


def replay_path(path):
    return (isinstance(path, str) and bool(path) and '\\' not in path and '\0' not in path
            and not re.match(r'^[A-Za-z]:', path)
            and all(p not in ('', '.', '..') for p in path.split('/')))


def replay_tree(run, revision):
    entries = {}
    for row in git('ls-tree', '-r', '-t', '-z', revision, cwd=run['repoRoot']).split('\0'):
        if row:
            meta, path = row.split('\t', 1)
            mode, kind, oid = meta.split()
            entries[path] = (mode, kind, oid)
    return entries


def replay_file_error(path, roots, tree):
    if not replay_path(path):
        return 'invalid relative path'
    if not any(path.startswith(root + '/') for root in roots):
        return 'outside accepted test roots'
    parts = path.split('/')
    for i in range(1, len(parts)):
        parent = tree.get('/'.join(parts[:i]))
        if parent and parent[1] != 'tree':
            return 'ancestor is a symlink or non-directory'
    entry = tree.get(path)
    if not entry:
        return 'file absent from revision'
    if entry[0] not in ('100644', '100755'):
        return 'not a regular file (symlink/submodule excluded)'
    return None


REPLAY_CACHE_FIELDS = ('exitCode', 'timedOut', 'seconds', 'tail', 'signal', 'passed', 'mutated')


def replay_cache_get(run, key):
    path = os.path.join(run['runDir'], 'cache', 'replay-base', key + '.json')
    try:
        cached = json.loads(read(path))
        if file_sha256(cached['log']) == cached['logSha256'] and set(cached['record']) == set(REPLAY_CACHE_FIELDS):
            return cached
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def replay_cache_put(run, key, record):
    folder = os.path.join(run['runDir'], 'cache', 'replay-base')
    os.makedirs(folder, exist_ok=True)
    log = os.path.join(folder, key + '.log')
    shutil.copyfile(record['log'], log)
    write_json(os.path.join(folder, key + '.json'), {'log': log, 'logSha256': file_sha256(log),
                                                     'record': {k: record[k] for k in REPLAY_CACHE_FIELDS}})


def run_replay(run, spec, snapshot_info, live, settings):
    """Pair file-level raw evidence; no interpretation of red/green or test assertions."""
    started = time.time()
    request = spec['replay']
    base, final = run['head'], snapshot_info['commit']
    trees = {side: replay_tree(run, revision) for side, revision in [('base', base), ('final', final)]}
    out = {'base': base, 'snapshot': final, 'snapshotTree': snapshot_info['tree'],
           **request, 'changes': [], 'exclusions': [], 'records': []}

    def exclude(path, reason):
        item = {'path': path, 'reason': reason}
        if item not in out['exclusions']:
            out['exclusions'].append(item)

    for dependency in DEPS:
        if os.path.isdir(os.path.join(live, dependency)):
            exclude(dependency, 'author dependency changes are not overlaid onto base; base uses the original run repository copy, final uses author dependencies like the full gate')
    roots = []
    for root in request['testRoots']:
        # The reviewer checks base layout/configuration. A configured test directory may not
        # exist yet; Git independently rejects non-directory roots and unsafe ancestors.
        if not replay_path(root) or trees['base'].get(root, ('', 'tree'))[1] != 'tree':
            exclude(root, 'test root is invalid or is not a regular base directory')
        elif any(trees['base'].get('/'.join(root.split('/')[:i]), ('', 'tree'))[1] != 'tree'
                 for i in range(1, len(root.split('/')))):
            exclude(root, 'test root has a symlink/non-directory ancestor')
        else:
            roots.append(root)
    raw = git('diff', '--name-status', '-z', '-M', base, final, cwd=run['repoRoot']).split('\0')
    changes = {}
    i = 0
    while i < len(raw) and raw[i]:
        status, path = raw[i:i + 2]
        i += 2
        previous = ''
        if status[0] in ('R', 'C'):
            previous, path = path, raw[i]
            i += 1
        changes[path] = status[0]
        out['changes'].append({'status': status, 'path': path, 'previousPath': previous})
        if previous:
            exclude(previous, f'rename/copy source for {path}; no deletion or rename is overlaid')
    requested = {path for e in request['mapping'] for path in [e['file'], *e['fixtures']]}
    overlays = set()
    for path in sorted(set(changes) | requested):
        error = replay_file_error(path, roots, trees['final'])
        status = changes.get(path)
        if error:
            exclude(path, error)
        elif status not in ('A', 'M'):
            exclude(path, 'unchanged; use original base file without overlay' if status is None
                    else f'unsupported overlay change {status}; renames/deletions/type changes are not copied')
        elif path not in requested:
            exclude(path, 'changed test file not requested in current replay mapping')
        else:
            # Even a safe final file cannot overwrite a base symlink or cross one.
            base_error = replay_file_error(path, roots, trees['base'])
            if base_error and base_error != 'file absent from revision':
                exclude(path, 'base destination: ' + base_error)
            else:
                overlays.add(path)
    def execute(n, entry, side, revision):
        """One (entry, side) execution in its own checkout and TMPDIR. Returns its exclusions and
        record, so results merge in mapping order whatever order the executions finish in."""
        excluded, paths = [], list(dict.fromkeys([entry['file'], *entry['fixtures']]))
        invalid = []
        for path in paths:
            error = replay_file_error(path, roots, trees['final'])
            if not error and side == 'base' and path not in overlays:
                if path in changes:
                    error = 'changed file cannot be overlaid'
                else:
                    error = replay_file_error(path, roots, trees['base'])
            if error:
                invalid.append(path)
                excluded.append((path, f'{side} execution not scheduled: {error}'))
        if invalid:
            return excluded, None
        label = f'{spec["label"]}-replay-{n}-{side}'
        log = os.path.join(run['runDir'], 'logs', f'replay-{spec["seat"]}-{label}.log')
        cwd = os.path.join(run['runDir'], 'scratch', f'{spec["seat"]}-{label}-{os.getpid()}')
        record = {'side': side, 'revision': revision,
                  'tree': git('rev-parse', f'{revision}^{{tree}}', cwd=run['repoRoot']).strip(),
                  'file': entry['file'], 'command': entry['command'], 'checkIds': entry['checkIds'],
                  'cwd': cwd, 'attempted': False, 'ran': False, 'passed': False,
                  'hasExitCode': False, 'exitCode': 0, 'signal': 0, 'timedOut': False,
                  'seconds': 0, 'log': log, 'logSha256': '', 'tail': '', 'launchError': '', 'mutated': [], 'reused': False}
        key = None
        if side == 'base':
            # The base commit never changes within a run, so an execution whose inputs are the same
            # bytes is the same execution: reuse it rather than spend another checkout and run.
            inputs = sorted((path, trees['final' if path in overlays else 'base'][path][2]) for path in paths)
            key = hashlib.sha256(json.dumps([base, entry['command'], inputs, spec['testTimeout'], settings],
                                            sort_keys=True).encode()).hexdigest()
            cached = replay_cache_get(run, key)
            if cached:
                shutil.copyfile(cached['log'], log)
                record.update(cached['record'], attempted=True, ran=True, hasExitCode=True, reused=True,
                              logSha256=file_sha256(log))
                return excluded, record
        cwd, error = scratch_checkout(run, spec['seat'], label, revision, run['repoRoot'] if side == 'base' else live)
        if error:
            return excluded + [(entry['file'], f'{side} checkout failed; execution not scheduled: {error}')], None
        try:
            if side == 'base':
                for path in paths:
                    if path not in overlays:
                        continue
                    dst = safe_relative(cwd, path)
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    mode, _, oid = trees['final'][path]
                    data = subprocess.check_output(['git', 'cat-file', 'blob', oid], cwd=run['repoRoot'], close_fds=True)
                    with open(dst, 'wb') as f:
                        f.write(data)
                    os.chmod(dst, 0o755 if mode == '100755' else 0o644)
            record['attempted'] = True
            try:
                with verification_temp(run, settings) as env:
                    result = run_shell(entry['command'], cwd, spec['testTimeout'], log, env=env)
                record.update(result, ran=True, hasExitCode=True)
                record['signal'] = -result['exitCode'] if result['exitCode'] < 0 else 0
                record['mutated'] = tracked_changes(cwd) if side == 'final' else []
                record['passed'] = result['exitCode'] == 0 and not result['timedOut'] and not record['mutated']
            except (OSError, VerificationInfrastructureError) as e:
                record['launchError'] = str(e)
                record['tail'] = str(e)
                write(log, str(e) + '\n')
            record['logSha256'] = file_sha256(log)
            if key and record['ran'] and not record['launchError'] and not record['timedOut']:
                replay_cache_put(run, key, record)
            return excluded, record
        except (CouncilError, OSError, subprocess.CalledProcessError) as e:
            return excluded + [(entry['file'], f'{side} preparation failed; execution not scheduled: {e}')], None
        finally:
            drop_checkout(run, cwd)

    tasks = [(n, entry, side, revision) for n, entry in enumerate(request['mapping'])
             for side, revision in [('base', base), ('final', final)]]
    with ThreadPoolExecutor(max_workers=verification_concurrency(run)) as pool:
        results = [f.result() for f in [pool.submit(execute, *t) for t in tasks]]
    for excluded, record in results:
        for path, reason in excluded:
            exclude(path, reason)
        if record:
            out['records'].append(record)
    out['elapsedSec'] = round(time.time() - started, 1)
    return out


def run_measure_job(jd, spec):
    started = time.time()
    run = load_run(spec['runDir'])
    live = spec.get('path') or seat_tree(run, spec['seat'])
    out = {'status': 'done', 'job': spec['job'], 'seat': spec['seat'], 'label': spec['label'], 'tree': live}
    settings = spec['verification'] if 'verification' in spec else verification_settings(run)
    out['verification'] = settings
    cwd, scratch = live, None
    if spec.get('snapshot', True):
        out['snapshot'] = snapshot(run, spec['seat'], spec['label'], spec.get('path'), spec.get('since'))
        scratch, err = scratch_checkout(run, spec['seat'], spec['label'], out['snapshot']['commit'], live)
        out['scratch'] = bool(scratch)
        if scratch:
            cwd = scratch
            out['checkout'] = 'standalone' if os.path.isdir(scratch + '.gitdir') else 'worktree'
        else:
            out['scratchError'] = f'ran in the live worktree instead: {err}'
            if run.get('factory'):
                # The environment failed, not the snapshot: failureKind tells Pair to stop rather
                # than send unchanged bytes through more review.
                out['scratchError'] = err
                out['suite'] = {'ran': False, 'passed': False, 'command': settings['command'], 'failureKind': 'infrastructure',
                                'log': '', 'tail': 'Disposable verification checkout failed: ' + err}
                out['crossTests'] = []
                return out
    post = os.path.join(run['room'], spec['label'], f'{spec["seat"]}.md')
    out['postWords'] = len(read(post).split()) if os.path.exists(post) else None
    try:
        replay = None
        if spec.get('replay') is not None:
            # The replay uses its own checkouts, so it runs beside the suite unless the repository's
            # tests must run one at a time.
            serial = verification_concurrency(run) == 1
            replay = ThreadPoolExecutor(max_workers=1)
            pending = replay.submit(run_replay, run, spec, out['snapshot'], live, settings)
            if serial:
                out['replay'] = pending.result()
        try:
            out['suite'] = suite(run, cwd, spec['label'], spec['seat'], spec['suiteTimeout'], settings)
        finally:
            if replay:
                out['replay'] = pending.result()
                replay.shutdown()
        if scratch:
            # The suite must not change tracked files; reset them so cross-tests start from the snapshot.
            mutated = tracked_changes(scratch)
            if mutated:
                out['suite']['mutated'] = mutated[:20]
                if run.get('factory'):
                    out['suite']['passed'] = False
                    out['suite']['tail'] += '\nVerification changed tracked snapshot files: ' + ', '.join(mutated[:20])
                git('checkout', '-q', '--', '.', cwd=scratch, check=False)
            if not run.get('factory') and out['suite'].get('ran') and not out['suite'].get('passed') and not out['suite'].get('timedOut'):
                # The checkout has only the tracked files and the dependency dirs. A suite that also
                # needs some other ignored file (a local .env or phpunit.xml) fails here and not in the
                # seat's tree; that must not disqualify the seat, so the live tree's result stands.
                live_run = suite(run, live, f'{spec["label"]}-live', spec['seat'], spec['suiteTimeout'], settings)
                if live_run.get('passed'):
                    out['suite'] = dict(live_run, scratchFailed=tail(out['suite'].get('tail', ''), 15))
        out['crossTests'] = crosstest(run, cwd, spec['label'], spec['seat'], spec['tests'], spec['testTimeout'],
                                      reset=scratch is not None, env=verification_environment(settings))
    finally:
        if scratch:
            drop_checkout(run, scratch)
    out['elapsedSec'] = round(time.time() - started, 1)
    if run.get('factory') and out.get('snapshot'):
        try:
            out['evidence'] = publish_evidence(run, spec['seat'], spec['label'], out)
        except (CouncilError, OSError, ValueError) as e:
            out['evidence'] = {'status': 'error', 'error': str(e)}
            # Never leave the previous publication discoverable as evidence for a new tree.
            pointer = os.path.join(run['runDir'], 'evidence', f'{spec["seat"]}-{spec["label"]}.json')
            if os.path.exists(pointer):
                os.remove(pointer)
    return out


def input_digest(run, seat, label, path, tests, replay=None):
    """Everything a measurement's result depends on: the seat's tree as it is now (written with a
    throwaway index, as snapshot does) and the commits under it, its post, the verification command
    and the published tests.
    A finished measurement is reused only when all of it is unchanged."""
    wt = path or seat_tree(run, seat)
    base = seat_head(run, wt)
    tree = worktree_tree(run, wt, f'index-digest-{seat}-{label}-{os.getpid()}', base)

    def digest_of(p):
        if os.path.isfile(p):
            return prompt_hash(read(p))
        if os.path.isdir(p):
            files = sorted(os.path.relpath(os.path.join(b, n), p) for b, _, ns in os.walk(p) for n in ns)
            return prompt_hash('\n'.join(f'{f} {prompt_hash(read(os.path.join(p, f)))}' for f in files))
        return None
    return {'tree': tree, 'head': base,
            'post': digest_of(os.path.join(run['room'], label, f'{seat}.md')),
            'verify': digest_of(os.path.join(run['runDir'], 'verify.sh')),
            'verification': verification_settings(run),
            **({'replay': replay, 'originalBase': run['head']} if replay is not None else {}),
            **({'evidence': evidence_inputs(run, seat)} if run.get('factory') else {}),
            'tests': {t: digest_of(os.path.join(run['room'], 'tests', t)) for t in tests}}


# What Pair's engine reads from a measurement, each field with the value it takes when missing. A
# native Claude transport retypes this into its structured output, so it leaves out each execution's
# output tail, checkout path and log digest; the job's status.json keeps the full record. Must match
# PAIR_MEASURE_SCHEMA in src/pair-schemas.js (test/pair.mjs compares them).
PAIR_BRIEF = {
    'status': '', 'error': '', 'scratchError': '',
    'snapshot': {'ref': '', 'tree': '', 'diff': ''},
    'suite': {'ran': False, 'passed': False, 'command': '', 'failureKind': '', 'log': ''},
    'replay': {
        'base': '', 'snapshot': '', 'snapshotTree': '', 'testRoots': [''],
        'mapping': [{'file': '', 'command': '', 'checkIds': [''], 'fixtures': ['']}],
        'changes': [{'status': '', 'path': '', 'previousPath': ''}],
        'exclusions': [{'path': '', 'reason': ''}],
        'records': [{'side': '', 'revision': '', 'tree': '', 'file': '', 'command': '', 'checkIds': [''],
                     'attempted': False, 'ran': False, 'passed': False, 'hasExitCode': False, 'exitCode': 0,
                     'signal': 0, 'timedOut': False, 'seconds': 0, 'log': '', 'launchError': '',
                     'mutated': [''], 'reused': False}],
        'elapsedSec': 0,
    },
}


def brief_pick(value, shape):
    if isinstance(shape, dict):
        value = value if isinstance(value, dict) else {}
        return {k: brief_pick(value.get(k), s) for k, s in shape.items()}
    if isinstance(shape, list):
        return [brief_pick(v, shape[0]) for v in value] if isinstance(value, list) else []
    return shape if value is None else value


def measurement_brief(state):
    """A finished measurement in the shape of PAIR_BRIEF; a running job's answer is unchanged."""
    if state.get('status') == 'running':
        return state
    return dict(brief_pick(state, PAIR_BRIEF), status='done' if state.get('status') == 'done' else 'error')


def cmd_measure(a):
    run = load_run(a.run_dir)
    tests = [t for t in (a.tests or '').split(',') if t]
    key = f'measure-{a.seat}-{a.label}'
    jd = job_dir(a.run_dir, key)
    path = os.path.abspath(a.path) if a.path else None
    replay = replay_request(json.loads(a.replay_json)) if a.replay_json is not None else None
    if replay is not None and a.no_snapshot:
        raise CouncilError('replay requires a snapshot')
    spec = {'kind': 'measure', 'runDir': run['runDir'], 'seat': a.seat, 'label': a.label, 'job': key,
            'tests': tests, 'path': path, 'since': a.since,
            'snapshot': not a.no_snapshot, 'suiteTimeout': a.suite_timeout, 'testTimeout': a.test_timeout,
            'inputs': input_digest(run, a.seat, a.label, path, tests, replay), 'verification': verification_settings(run),
            **({'replay': replay} if replay is not None else {})}

    def decide(old, state):
        status = state and state.get('status')
        if status == 'running':
            if old != spec:
                raise CouncilError('measurement is running with different inputs; wait, then measure again')
            return 'wait'
        if old == spec and status == 'done':
            if replay is not None:
                for record in (state.get('replay') or {}).get('records', []):
                    try:
                        if file_sha256(record['log']) != record['logSha256']:
                            return None
                    except (OSError, KeyError):
                        return None
            if run.get('factory') and spec['snapshot']:
                try:
                    inspect_evidence(run, a.seat, a.label)
                except (CouncilError, OSError, ValueError, KeyError):
                    return None
            return dict(state, reused=True)
        return None                                      # failed, or something it depends on changed

    show = (lambda state: emit(measurement_brief(state))) if a.brief else (lambda state: emit(state))
    if settle_existing_job(jd, key, a.max_wait, decide, show):
        return
    if run.get('factory'):
        pointer = os.path.join(run['runDir'], 'evidence', f'{a.seat}-{a.label}.json')
        if os.path.exists(pointer):
            os.remove(pointer)
    start_job(jd, spec)
    show(wait_job(jd, key, a.max_wait))


def checkout_snapshot(run, seat, label, path):
    """A checkout of the seat's <label> snapshot at `path`, created once and reused after."""
    ref = f'refs/council/{run["runId"]}/{seat}-{label}'
    if not git('rev-parse', '--verify', '--quiet', ref, cwd=run['repoRoot'], check=False).strip():
        raise CouncilError(f'no snapshot {seat}-{label} (it is taken when that round is measured)')
    if not os.path.exists(path):
        detached_checkout(run, path, ref)
        clone_deps(run['repoRoot'], path)
        if run.get('factory'):
            copy_agent_docs(run['repoRoot'], path, untracked=True)
    return ref


def cmd_materialize(a):
    run = load_run(a.run_dir)
    name = a.name or f'{a.seat}-{a.label}'
    if not re.fullmatch(r'[A-Za-z0-9._-]+', name):
        raise CouncilError(f'invalid checkout name: {name}')
    path = os.path.join(run['runDir'], 'snap', name)
    ref = checkout_snapshot(run, a.seat, a.label, path)
    emit({'status': 'ok', 'path': path, 'ref': ref})


# ---------------------------------------------------------------- delivery verification (never applies a patch)

def checkout_changes(repo):
    return sorted(set(git('diff', '--name-only', '-z', 'HEAD', cwd=repo).split('\0')[:-1] +
                      git('ls-files', '--others', '--exclude-standard', '-z', cwd=repo).split('\0')[:-1]))


def checkout_file(repo, rel):
    # A leaf symlink is a Git blob; parent symlinks must never escape the checkout.
    parent, name = os.path.split(rel)
    path = os.path.join(safe_relative(repo, parent) if parent else repo, name)
    if not name or name in ('.', '..') or os.path.isabs(rel) or rel.split('/')[0] in ('.git', '.council'):
        raise CouncilError(f'invalid checkout path: {rel}')
    if not os.path.lexists(path):
        return None
    if os.path.islink(path):
        data, mode = os.readlink(path).encode(), '120000'
    elif os.path.isfile(path):
        with open(path, 'rb') as f:
            data = f.read()
        mode = '100755' if os.stat(path).st_mode & 0o111 else '100644'
    else:
        raise CouncilError(f'delivery does not support directory/submodule changes: {rel}')
    blob = subprocess.run(['git', 'hash-object', '--stdin'], cwd=repo, input=data, capture_output=True, check=True, close_fds=True)
    return {'mode': mode, 'blob': blob.stdout.decode().strip(), 'sha256': hashlib.sha256(data).hexdigest()}


def tree_files(repo, ref):
    result = {}
    for row in git('ls-tree', '-r', '-z', ref, cwd=repo).split('\0'):
        if not row:
            continue
        meta, path = row.split('\t', 1)
        mode, kind, blob = meta.split()
        result[path] = {'mode': mode, 'blob': blob}
    return result


def delivery_entries(manifest):
    if not isinstance(manifest, dict) or set(manifest) != {'adjustments', 'handoffs'}:
        raise CouncilError('delivery manifest requires adjustments and handoffs arrays')
    seen = set()
    for kind in ('adjustments', 'handoffs'):
        if not isinstance(manifest[kind], list):
            raise CouncilError(f'delivery {kind} must be an array')
        for item in manifest[kind]:
            if not isinstance(item, dict) or set(item) != {'path', 'reason', 'sha256'}:
                raise CouncilError('delivery entries require path, reason and sha256 (or "absent" for deletion)')
            if not all(isinstance(v, str) and v.strip() for v in item.values()) or item['path'] in seen:
                raise CouncilError('delivery entries must be nonempty and paths unique')
            if not re.fullmatch(r'[0-9a-f]{64}|absent', item['sha256']):
                raise CouncilError('delivery sha256 must be a SHA-256 digest or "absent"')
            seen.add(item['path'])
    return {item['path']: item for kind in ('adjustments', 'handoffs') for item in manifest[kind]}


def delivery_snapshot(run, final, diagnostic=False):
    repo = run['repoRoot']
    ref = final.get('snapshotRef', '')
    match = re.fullmatch(re.escape(f'refs/council/{run["runId"]}/') + r'([A-Z])-([A-Za-z0-9][A-Za-z0-9._-]*)', ref) if isinstance(ref, str) else None
    if not match:
        raise CouncilError('delivery requires this run\'s final snapshotRef')
    tree = git('rev-parse', f'{ref}^{{tree}}', cwd=repo).strip()
    if final.get('snapshotTree') != tree:
        raise CouncilError('snapshot no longer matches the tree in the factory result')
    ready = final.get('readiness', {})
    if not diagnostic and (ready.get('state') != 'ready' or ready.get('blocked') or ready.get('incomplete')):
        raise CouncilError('factory readiness has not passed; delivery cannot be verified')
    inspect_evidence(run, *match.groups())
    return ref


def inspect_delivery(run, final, manifest, diagnostic=False):
    repo = run['repoRoot']
    ref = delivery_snapshot(run, final, diagnostic)
    head = git('rev-parse', 'HEAD', cwd=repo).strip()
    ancestor = subprocess.run(['git', 'merge-base', '--is-ancestor', run['head'], head], cwd=repo,
                              stdin=subprocess.DEVNULL, capture_output=True, close_fds=True)
    if ancestor.returncode != 0:
        raise CouncilError('main HEAD no longer descends from the setup commit')
    if 'deliveryBaseline' not in run:
        raise CouncilError('run has no delivery baseline; use a factory run initialized with --factory')
    declared = delivery_entries(manifest)
    expected = tree_files(repo, ref)
    before = tree_files(repo, run['head'])
    changed = git('diff', '--no-renames', '--name-only', '-z', run['head'], ref, cwd=repo).split('\0')[:-1]
    committed = git('diff', '--no-renames', '--name-only', '-z', run['head'], head, cwd=repo).split('\0')[:-1]
    paths = sorted(set(changed) | set(committed) | set(checkout_changes(repo)) | set(run['deliveryBaseline']) | set(declared))
    matches, problems, states = [], [], {}
    for path in paths:
        actual = checkout_file(repo, path)
        states[path] = actual
        if path in declared:
            digest = actual['sha256'] if actual else 'absent'
            if digest != declared[path]['sha256']:
                problems.append(f'declared delivery bytes do not match: {path}')
            continue
        want = expected.get(path) if path in changed else run['deliveryBaseline'].get(path, before.get(path))
        same = actual is None and want is None or actual and want and all(actual[k] == want[k] for k in ('mode', 'blob'))
        if not same:
            problems.append(f'{"reviewed snapshot differs" if path in changed else "unrelated file changed"}: {path}')
        elif path in changed:
            matches.append(path)
    return {'snapshot': git('rev-parse', ref, cwd=repo).strip(), 'snapshotRef': ref, 'base': run['head'], 'mainHead': head,
            'reviewedFilesMatch': matches, 'problems': problems, 'files': states}


def run_delivery_job(jd, spec):
    run = load_run(spec['runDir'])
    reason = spec.get('diagnosticReason', '')
    before = inspect_delivery(run, spec['final'], spec['manifest'], bool(reason))
    result = {'status': 'incomplete', 'factoryReadiness': spec['final']['readiness'],
              'manifest': spec['manifest'], **({'diagnosticReason': reason} if reason else {}), **before}
    if not before['problems']:
        result['validation'] = suite(run, run['repoRoot'], 'delivery', 'main', spec['suiteTimeout'], spec['verification'])
        after = inspect_delivery(run, spec['final'], spec['manifest'], bool(reason))
        result['problems'] = after['problems']
        if after['files'] != before['files'] or after['mainHead'] != before['mainHead'] or after['snapshot'] != before['snapshot']:
            result['problems'].append('project checks changed delivery files')
        gate_ok = result['validation'].get('passed') or not spec['verification']['command']
        if gate_ok and not result['problems']:
            result['status'] = 'verified-diagnostic' if reason else 'delivered'
    checked = pin_guard(run['runDir'], repo=run['repoRoot'], final=spec['final'])
    if checked:
        candidate = checked['candidate']
        candidate['baseCommit'] = run['head']
        candidate['baseTree'] = git('rev-parse', run['head'] + '^{tree}', cwd=run['repoRoot']).strip()
        candidate['deliveredTree'] = worktree_tree(run, run['repoRoot'], 'index-delivery-provenance', result['mainHead']) if result['status'] == 'delivered' else None
        candidate['deliveredCommit'] = result['mainHead'] if candidate['deliveredTree'] == git('rev-parse', 'HEAD^{tree}', cwd=run['repoRoot']).strip() else None
        result['provenance'] = {'version': 1, 'executor': checked['executor'], 'evaluator': {'packageDigest': checked['executor']['packageDigest'], 'entrypoint': 'bin/dark-factory'}, 'candidate': candidate}
    write_json(os.path.join(run['runDir'], 'delivery-diagnostic.json' if reason else 'delivery.json'), result)
    return result


def cmd_verify_delivery(a):
    run = load_run(a.run_dir)
    report = json.loads(read(a.result))
    if report.get('artifactType') == 'dark-factory-summary':
        raise CouncilError('verify-delivery requires the full result; summary.json is informational only')
    if os.path.realpath(report.get('runDir', '')) != os.path.realpath(run['runDir']):
        raise CouncilError('result belongs to a different run')
    manifest = json.loads(read(a.manifest)) if a.manifest else {'adjustments': [], 'handoffs': []}
    final = report.get('final', {})
    reason = (a.diagnostic_reason or '').strip()
    if a.diagnostic_reason is not None and not reason:
        raise CouncilError('--diagnostic-reason requires a nonempty explanation')
    output = os.path.join(run['runDir'], 'delivery-diagnostic.json' if reason else 'delivery.json')
    try:
        inspect_delivery(run, final, manifest, bool(reason))
    except (CouncilError, OSError, ValueError, KeyError) as e:
        write_json(output, {'status': 'incomplete', 'problems': [str(e)], **({'diagnosticReason': reason} if reason else {})})
        raise
    key = 'verify-delivery-diagnostic' if reason else 'verify-delivery'
    jd = job_dir(a.run_dir, key)
    spec = {'kind': 'delivery', 'job': key, 'runDir': run['runDir'], 'final': final,
            'manifest': manifest, 'verification': verification_settings(run), 'suiteTimeout': a.suite_timeout, 'diagnosticReason': reason}
    def decide(old, state):
        if state and state.get('status') == 'running':
            if old != spec:
                raise CouncilError('delivery verification is already running with different inputs')
            return 'wait'
        return None
    if settle_existing_job(jd, key, a.max_wait, decide):
        return
    write_json(output, {'status': 'pending', 'job': key})
    start_job(jd, spec)
    emit(wait_job(jd, key, a.max_wait))


def cmd_apply(a):
    run = load_run(a.run_dir)
    report = json.loads(read(a.result or os.path.join(run['runDir'], 'result.json')))
    if report.get('artifactType') != 'dark-factory-result' or report.get('artifactVersion') != 1:
        raise CouncilError('apply requires a full dark-factory-result v1; summary.json is informational only')
    if os.path.realpath(report.get('runDir', '')) != os.path.realpath(run['runDir']):
        raise CouncilError('result belongs to a different run')
    final, repo = report.get('final', {}), run['repoRoot']
    ref = delivery_snapshot(run, final)
    if git('rev-parse', 'HEAD', cwd=repo).strip() != run['head']:
        raise CouncilError('HEAD changed since setup; apply requires the original base')
    if git('status', '--porcelain', '--untracked-files=no', cwd=repo).strip():
        raise CouncilError('apply requires a clean tracked checkout and index; existing changes were preserved')
    baseline = run.get('deliveryBaseline', {})
    for path in set(checkout_changes(repo)) | set(baseline):
        if checkout_file(repo, path) != baseline.get(path):
            raise CouncilError(f'local file changed since setup and would not pass delivery verification: {path}')
    paths = git('diff', '--name-only', '-z', run['head'], ref, cwd=repo).split('\0')[:-1]
    # Refuse collisions with untracked/ignored local files, including a parent path.
    before = tree_files(repo, run['head'])
    for path in paths:
        if path not in before and os.path.lexists(os.path.join(repo, path)):
            raise CouncilError(f'local file would be overwritten: {path}')
        parent = os.path.dirname(path)
        if parent:
            safe_relative(repo, parent)
    patch = subprocess.check_output(['git', 'diff', '--binary', '--no-ext-diff', run['head'], ref], cwd=repo, close_fds=True)
    if patch:
        for flags in (['--check', '--index'], ['--index']):
            r = subprocess.run(['git', 'apply', *flags, '-'], input=patch, cwd=repo, capture_output=True, close_fds=True)
            if r.returncode:
                raise CouncilError(r.stderr.decode(errors='replace').strip())
    tree = git('write-tree', cwd=repo).strip()
    if tree != final['snapshotTree']:
        raise CouncilError('applied index differs from reviewed snapshot; changes retained for inspection')
    result = inspect_delivery(run, final, {'adjustments': [], 'handoffs': []})
    if result['problems']:
        raise CouncilError('applied checkout differs: ' + '; '.join(result['problems']))
    emit({'status': 'applied', 'snapshotRef': ref, 'snapshotTree': tree, 'runDir': run['runDir'],
          'next': 'Run dark-factory verify-delivery before committing.'})


# ---------------------------------------------------------------- reporting and cleanup

def cmd_usage(a):
    path = os.path.join(a.run_dir, 'usage.jsonl')
    by_model = {}
    if os.path.exists(path):
        for line in read(path).split('\n'):
            if not line.strip():
                continue
            rec = json.loads(line)
            m = by_model.setdefault(rec['model'], {'turns': 0, 'seconds': 0})
            m['turns'] += 1
            m['seconds'] = round(m['seconds'] + rec.get('seconds', 0), 1)
            for k, v in rec.get('usage', {}).items():
                m[k] = m.get(k, 0) + v
    out = {'status': 'ok', 'byModel': by_model}
    if not a.no_claude:
        out['claude'] = claude_usage(load_run(a.run_dir))
    emit(out)


USAGE_KEYS = ('input_tokens', 'output_tokens', 'cache_creation_input_tokens', 'cache_read_input_tokens')


def agent_role(label):
    """The council role behind a workflow agent's label (see the labels council.js gives agents)."""
    for role, pat in (('relay', r'\(relay'), ('setup', r'^setup$'), ('retro', r'^retro$'), ('intake', r'^intake$'),
                      ('record', r'^record$'), ('checker', r'^check '),
                      ('panel', r'^panel '), ('questions', r'^questions '), ('ballot', r'^b\d+:'),
                      ('auditor', r'^(re)?audit '), ('spec', r'^spec '), ('seat', r'^(r\d+|final\d?|ratify|inc\d+):')):
        if re.search(pat, label or ''):
            return role
    return 'other'


def claude_usage(run):
    """Token use of this run's Claude agents (seats, checkers, panel, relays, setup, retro), read from
    their saved transcripts: Claude Code keeps one per agent, and every council prompt names the run
    directory. Each API message is counted once, though a transcript may log it more than once."""
    base = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.expanduser('~/.claude')
    created = os.path.getmtime(os.path.join(run['runDir'], 'run.json'))
    needle = run['runDir'].encode()
    by_model, by_role, agents = {}, {}, 0
    for dirpath, _, names in os.walk(os.path.join(base, 'projects')):
        for name in names:
            if not (name.startswith('agent-') and name.endswith('.jsonl')):
                continue
            path = os.path.join(dirpath, name)
            try:
                if os.path.getmtime(path) < created:
                    continue
                with open(path, 'rb') as f:
                    data = f.read()
            except OSError:
                continue
            if needle not in data:
                continue
            meta_path = path[:-len('.jsonl')] + '.meta.json'
            try:
                meta = json.loads(read(meta_path)) if os.path.exists(meta_path) else {}
            except ValueError:
                meta = {}
            messages = {}
            for raw in data.split(b'\n'):
                try:
                    msg = json.loads(raw).get('message') or {}
                except (ValueError, AttributeError):
                    continue
                if isinstance(msg, dict) and msg.get('role') == 'assistant' and isinstance(msg.get('usage'), dict):
                    messages[msg.get('id') or len(messages)] = msg           # the last record of a message wins
            if not messages:
                continue
            agents += 1
            role = agent_role(meta.get('description', ''))
            for msg in messages.values():
                for bucket in (by_model.setdefault(msg.get('model') or meta.get('model') or '?', {'messages': 0}),
                               by_role.setdefault(role, {'messages': 0})):
                    bucket['messages'] += 1
                    for k in USAGE_KEYS:
                        v = msg['usage'].get(k)
                        if isinstance(v, (int, float)):
                            bucket[k] = bucket.get(k, 0) + v
    return {'agents': agents, 'byModel': by_model, 'byRole': by_role}


# ---------------------------------------------------------------- preflight

VENDOR_EXE = {'codex': 'codex', 'gemini': 'agy', 'claude': 'claude'}


def cmd_preflight(a):
    """Check, before any seat starts, that each external vendor's CLI can run from here: it is on
    PATH, answers --version, and isn't stuck inside Claude Code's sandbox (the same probe seat-run
    makes). Gemini also needs agy's proceed-in-sandbox mode. Costs no model turn."""
    vendors = [v for v in (a.vendors or '').split(',') if v]
    unknown = [v for v in vendors if v not in VENDOR_EXE]
    if unknown:
        raise CouncilError(f'unknown vendor(s): {", ".join(unknown)}')
    checks = {}
    for v in vendors:
        exe = VENDOR_EXE[v]
        c = {'ok': False, 'exe': exe}
        checks[v] = c
        if not shutil.which(exe):
            c['error'] = f'{exe} is not on PATH'
            continue
        try:
            blocked = vendor_blocked(v)
        except CouncilError as e:
            c['error'] = str(e)
            continue
        if blocked:
            c.update(sandboxed=True, error=blocked)
            continue
        if v == 'gemini':
            path = os.path.join(agy_home(), 'settings.json')
            try:
                settings = json.loads(read(path)) if os.path.exists(path) else {}
            except ValueError:
                settings = {}
            if settings.get('toolPermission') != 'proceed-in-sandbox':
                c['error'] = f'Gemini seats need "toolPermission": "proceed-in-sandbox" in {path}'
                continue
        try:
            r = subprocess.run([exe, '--version'], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60, close_fds=True)
        except (OSError, subprocess.TimeoutExpired) as e:
            c['error'] = f'{exe} --version failed: {e}'
            continue
        if r.returncode != 0:
            c['error'] = f'{exe} --version exited {r.returncode}: {oneline(r.stderr or r.stdout, 200)}'
            continue
        c.update(ok=True, version=oneline(r.stdout, 80))
    bad = {v: c for v, c in checks.items() if not c['ok']}
    status = 'ok' if not bad else 'sandboxed' if all(c.get('sandboxed') for c in bad.values()) else 'error'
    emit({'status': status, 'vendors': checks})


def cmd_cleanup(a):
    run = load_run(a.run_dir)
    root, removed = run['repoRoot'], []
    for sub in ('wt', 'snap'):
        base = os.path.join(run['runDir'], sub)
        for name in sorted(os.listdir(base)) if os.path.isdir(base) else []:
            path = os.path.join(base, name)
            git('worktree', 'remove', '--force', path, cwd=root, check=False)
            shutil.rmtree(path, ignore_errors=True)
            removed.append(path)
    git('worktree', 'prune', cwd=root, check=False)
    refs = [r for r in git('for-each-ref', '--format=%(refname)', f'refs/council/{run["runId"]}/',
                           cwd=root).split('\n') if r]
    for r in refs:
        git('update-ref', '-d', r, cwd=root, check=False)
    if a.all:
        shutil.rmtree(run['runDir'], ignore_errors=True)
    emit({'status': 'ok', 'worktreesRemoved': len(removed), 'refsDeleted': len(refs),
          'kept': None if a.all else run['room']})


# ---------------------------------------------------------------- retro

# A development checkout (plugins/dark-factory/bin/ under the repo) keeps retros in the repo, next
# to the code they tune. An installed plugin's directory is replaced on every update, so elsewhere
# they go under ~/.claude.
_CHECKOUT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(SELF))))
RETRO_DIR = (os.path.join(_CHECKOUT, 'retros')
             if os.path.isfile(os.path.join(_CHECKOUT, '.claude-plugin', 'marketplace.json'))
             and os.path.isdir(os.path.join(_CHECKOUT, '.git'))
             else os.path.expanduser('~/.claude/dark-factory/retros'))


FACTS_RE = re.compile(r'^## Run facts \(data\)\n\n```json\n(.*?)\n```', re.S | re.M)


def facts_of(payload):
    """The JSON facts a factory run puts in its retro payload, or None."""
    m = FACTS_RE.search(payload or '')
    if not m:
        return None
    try:
        return json.loads(m.group(1))
    except ValueError:
        return None


# ---------------------------------------------------------------- timeline

# Native workflows have no replay-safe clock, so the helper records when it was called and when
# each job ran. Gaps between events longer than this count as paused (a resume, the user away).
TIMELINE_GAP_SEC = 15 * 60
TIMELINE_COMMANDS = ('init', 'measure', 'seat-run', 'wait', 'materialize', 'verify-delivery', 'retro')


def timeline_event(run_dir, event, job=None, at=None):
    """Append one line to <run>/timeline.jsonl. Best effort: a clock must never fail a command."""
    line = json.dumps({'at': (at or datetime.now(timezone.utc)).isoformat(timespec='milliseconds'), 'event': event, 'job': job})
    try:
        fd = os.open(os.path.join(run_dir, 'timeline.jsonl'), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, (line + '\n').encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def setup_started(value):
    """The time a native setup agent started, which it read with `date -u` before anything else and
    passed to init as --started-at: the native workflow has no replay-safe clock of its own. An ISO
    time with an offset, from the last hour and not in the future; anything else is ignored, since
    a clock must never fail a command."""
    if not isinstance(value, str) or not value.strip():
        return None
    try:
        at = datetime.fromisoformat(value.strip().replace('Z', '+00:00'))
    except ValueError:
        return None
    if at.tzinfo is None:
        return None
    age = (datetime.now(timezone.utc) - at).total_seconds()
    return at.astimezone(timezone.utc) if -5 <= age <= 3600 else None


def timeline_role(job):
    if job.startswith('measure-'):
        return 'measure'
    if re.match(r'(review|audit|check|spec)-', job):
        return 'reviewer'
    return 'author'


def timeline_elapsed(run_dir):
    """Active time from <run>/timeline.jsonl: a job counts in full from start to end, and any other
    gap between consecutive events counts up to TIMELINE_GAP_SEC. A native Pair setup passes its
    start to init (a setup-start event), so its time before init counts; otherwise, and for intake,
    the time before init is not counted. None without a timeline."""
    path = os.path.join(run_dir, 'timeline.jsonl')
    if not os.path.isfile(path):
        return None
    events = []
    for line in read(path).split('\n'):
        try:
            e = json.loads(line) if line.strip() else None
            events.append((datetime.fromisoformat(e['at']).timestamp(), e.get('event'), e.get('job')))
        except (ValueError, TypeError, KeyError, AttributeError):
            continue
    if not events:
        return None
    events.sort(key=lambda e: e[0])
    open_jobs, spans = {}, []
    for at, event, job in events:
        if event == 'job-start' and job:
            open_jobs[job] = at
        elif event == 'job-end' and job in open_jobs:
            spans.append((open_jobs.pop(job), at, job))
    points = sorted({at for at, _, _ in events})
    total = 0.0
    for a, b in zip(points, points[1:]):
        covered = any(start <= a and b <= end for start, end, _ in spans)
        total += (b - a) if covered else min(b - a, TIMELINE_GAP_SEC)
    by_role = {'author': 0.0, 'reviewer': 0.0, 'measure': 0.0}
    for role in by_role:
        merged = []
        for start, end, _ in sorted(s for s in spans if timeline_role(s[2]) == role):
            if merged and start <= merged[-1][1]:
                merged[-1][1] = max(merged[-1][1], end)
            else:
                merged.append([start, end])
        by_role[role] = sum(end - start for start, end in merged)
    return {'elapsedMs': round(total * 1000), 'byRole': {k: round(v * 1000) for k, v in by_role.items()}}


def fill_metrics(run, facts):
    """Fill token evidence from vendor logs and native transcripts, and native active elapsed time
    from the helper's timeline (never run.json mtime, which includes idle time between resumes)."""
    m = facts.get('metrics') if isinstance(facts, dict) else None
    if not isinstance(m, dict):
        return facts
    if m.get('elapsedMs') is None:
        elapsed = timeline_elapsed(run['runDir'])
        if elapsed:
            m.update(elapsedMs=elapsed['elapsedMs'], elapsedSource='helper-timeline', elapsedByRole=elapsed['byRole'])
    if m.get('tokens') is None:
        by_model, records = {}, 0
        path = os.path.join(run['runDir'], 'usage.jsonl')
        if os.path.exists(path):
            for line in read(path).split('\n'):
                try:
                    rec = json.loads(line) if line.strip() else None
                except ValueError:
                    continue
                if not isinstance(rec, dict):
                    continue
                bucket = by_model.setdefault(rec.get('model') or '?', {})
                records += 1
                for k, v in (rec.get('usage') or {}).items():
                    if isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0:
                        bucket[k] = bucket.get(k, 0) + v
        try:
            claude = claude_usage(run)['byModel']
        except OSError:
            claude = {}
        for model, usage in claude.items():
            records += usage.get('messages', 0)
            bucket = by_model.setdefault(model, {})
            for key, value in usage.items():
                if key != 'messages' and isinstance(value, (int, float)) and not isinstance(value, bool) and value >= 0:
                    bucket[key] = bucket.get(key, 0) + value
        m['tokens'] = {'records': records, 'byModel': by_model} if records else None
    return facts


def retro_dir(a):
    return os.path.abspath(os.path.expanduser(a.out_dir or os.environ.get('COUNCIL_RETRO_DIR') or RETRO_DIR))


def cmd_retro(a):
    """Keep a run's retro where it outlives the run (`cleanup --all` deletes the run directory),
    next to the workflow it is about. The retro agent writes <run>/retro.md; the process notes
    and run facts it was given are read from its own saved prompt, hash-checked, as seat-run
    reads a relay's payload, so no model copies them. A factory run's facts are also kept as
    <run>-<repo>.facts.json, for `retro --summary`; --facts-only keeps just those."""
    if a.summary:
        print(retro_summary(retro_dir(a)))
        return
    if not a.run_dir:
        raise CouncilError('retro needs --run-dir (or --summary)')
    run = load_run(a.run_dir)
    path = os.path.join(run['runDir'], 'retro.md')
    if not a.facts_only and not os.path.isfile(path):
        raise CouncilError(f'write the retro to {path} first')
    payload_file = getattr(a, 'payload_file', None)
    if payload_file:
        data = read(payload_file)
        if a.expect and prompt_hash(data) != a.expect:
            raise CouncilError('retro payload file does not match --expect')
    else:
        data = payload_from_transcripts(a.expect, a.transcript_wait) if a.expect else None
    if data is not None:
        write(os.path.join(run['runDir'], 'retro-data.md'), data + '\n')
    facts = facts_of(data)
    if a.facts_only and facts is None:
        raise CouncilError('no run facts found in the payload (is the record agent\'s transcript saved?)')
    out_dir = retro_dir(a)
    repo = re.sub(r'[^A-Za-z0-9._-]', '-', os.path.basename(run['repoRoot'])) or 'repo'
    base = os.path.join(out_dir, f"{run['runId']}-{repo}")
    try:
        if not a.facts_only:
            write(base + '.md', read(path).rstrip('\n') + ('\n\n' + data if data is not None else '') + '\n')
        if facts is not None:
            write_json(base + '.facts.json', fill_metrics(run, facts))
    except PermissionError as e:
        emit({'status': 'sandboxed', 'error': f'cannot write to {out_dir} ({e.strerror}). This command is running '
              'inside a sandbox that only allows writes to the project.'})
        return
    emit({'status': 'ok', 'path': base + ('.facts.json' if a.facts_only else '.md'), 'notes': data is not None, 'facts': facts is not None})


def retro_summary(out_dir):
    """How the factory's router has done, from every saved *.facts.json: per tier, the runs, how
    the tier was chosen, the escalations by trigger, the hints that a tier was too high, readiness
    and the median Claude turns. Plain text, for reading before tuning the intake rubric."""
    rows = []
    for name in sorted(os.listdir(out_dir)) if os.path.isdir(out_dir) else []:
        if name.endswith('.facts.json'):
            try:
                rows.append(json.loads(read(os.path.join(out_dir, name))))
            except (OSError, ValueError):
                continue
    if not rows:
        return f'No factory facts under {out_dir} yet.'

    def started(r):
        e = r.get('escalation')
        return e['from'] if e else r.get('tier') or '?'

    def tally(xs):
        out = {}
        for x in xs:
            out[x] = out.get(x, 0) + 1
        return ', '.join(f'{k} {v}' for k, v in sorted(out.items(), key=lambda kv: (-kv[1], str(kv[0])))) or 'none'

    lines = [f'{len(rows)} factory run(s) in {out_dir}', '']
    for tier in ['simple', 'fix', 'feature', 'architecture', '?']:
        rs = [r for r in rows if started(r) == tier]
        if not rs:
            continue
        esc = [r['escalation'] for r in rs if r.get('escalation')]
        turns = sorted((r.get('turns') or {}).get('claude', 0) for r in rs)
        over = [h for r in rs for h in (r.get('overTierHints') or [])]
        overruled = [r for r in rs if r.get('chosenBy') == 'overruled']
        lines.append(f'{tier}: {len(rs)} run(s), chosen by {tally(r.get("chosenBy") or "?" for r in rs)}')
        lines.append(f'  escalated: {len(esc)}' + (f' ({tally(e["trigger"] + " -> " + e["to"] for e in esc)})' if esc else ''))
        if overruled:
            lines.append(f'  overruled intake: {len(overruled)} (intake said {tally(r.get("recommended") or "?" for r in overruled)}; '
                         f'{sum(1 for r in overruled if r.get("escalation"))} of them escalated)')
        lines.append(f'  readiness: {tally(r.get("readiness") or "?" for r in rs)}')
        lines.append(f'  median Claude turns: {turns[len(turns) // 2]}')
        if over:
            lines.append(f'  hints the tier was too high: {tally(over)}')
    return '\n'.join(lines)


def cmd_hash(a):
    emit({'status': 'ok', 'hash': prompt_hash(read(a.file))})


# ---------------------------------------------------------------- detached job entry point

# A model at capacity or a short rate limit clears up within a minute or two, so a vendor turn that
# fails that way is retried once, here, instead of costing the relay a second agent. So is a
# malformed tool call by the vendor's own model (agy passes Gemini's "Malformed function call"
# through as the turn's error; the model usually gets it right on a second try). A used-up quota
# doesn't clear up, and a turn that hit its deadline would only hit it again: neither is retried.
TRANSIENT = re.compile(r'at capacity|overloaded|rate.?limit|too many requests|\b(429|503)\b|'
                       r'temporarily unavailable|try again later|RESOURCE_EXHAUSTED|'
                       r'malformed function call|improperly formatted function call', re.I)


def error_class(err):
    """What kind of failure a vendor turn's error is, so callers act on a field, not on free text."""
    err = err or ''
    if re.search(r'timed out', err, re.I):
        return 'timeout'
    if re.search(r'quota', err, re.I):
        return 'quota'
    if TRANSIENT.search(err):
        return 'transient'
    if re.search(r'not logged in|log ?in again|unauthori[sz]ed|authenticat|\b401\b', err, re.I):
        return 'auth'
    return 'vendor'


def transient(result):
    return result.get('status') == 'error' and error_class(result.get('error')) == 'transient'


def cmd_job(jd):
    spec = json.loads(read(os.path.join(jd, 'spec.json')))
    run_dir = spec.get('runDir')
    if run_dir:
        timeline_event(run_dir, 'job-start', os.path.basename(jd))
    try:
        run_job_spec(jd, spec)
    finally:
        if run_dir:
            timeline_event(run_dir, 'job-end', os.path.basename(jd))


def run_job_spec(jd, spec):
    try:
        if spec.get('pin') and not os.environ.get('DARK_FACTORY_PIN'):
            os.environ['DARK_FACTORY_PIN'] = json.dumps(spec['pin'])
        pin_guard(spec.get('runDir'), spec if spec['kind'] in ('codex', 'gemini', 'claude') else None)
        if spec['kind'] in ('codex', 'gemini', 'claude'):
            if spec.get('resumeSession'):
                session_name = {'claude': 'claude-session', 'codex': 'thread', 'gemini': 'conversation'}[spec['kind']]
                path = os.path.join(spec['runDir'], 'seats', spec['seat'], session_name)
                if spec['fresh'] or not os.path.isfile(path) or read(path).strip() != spec['resumeSession']:
                    raise CouncilError('recovery session is missing or changed; refusing to start a fresh turn')
            run = {'codex': run_codex_job, 'gemini': run_gemini_job, 'claude': run_claude_job}[spec['kind']]
            result = run(jd, spec)
            if transient(result) and not spec.get('resumeSession'):
                first = result['error']
                time.sleep(float(os.environ.get('COUNCIL_RETRY_WAIT', '90')))
                pin_guard(spec.get('runDir'), spec)
                result = run(jd, spec)
                result['retried'] = oneline(first)[:300]
            if result.get('status') == 'error':
                result['errorClass'] = error_class(result.get('error'))
        elif spec['kind'] == 'measure':
            result = run_measure_job(jd, spec)
        elif spec['kind'] == 'verify':
            result = run_verify_job(jd, spec)
        elif spec['kind'] == 'delivery':
            result = run_delivery_job(jd, spec)
        else:
            result = {'status': 'error', 'error': f'unknown job kind {spec["kind"]}'}
        checked = pin_guard(spec.get('runDir'), spec if spec['kind'] in ('codex', 'gemini', 'claude') else None)
        if checked:
            result['executor'] = checked['executor']
            if checked.get('settings'):
                result['settingsHash'] = checked['settings']['settingsHash']
    except Exception as e:                                # the status file must always get written
        result = {'status': 'error', 'error': f'{type(e).__name__}: {e}', **({'code': 'ENGINE_DRIFT', 'errorClass': 'engine'} if 'ENGINE_DRIFT:' in str(e) else {})}
        if spec['kind'] == 'delivery':
            write_json(os.path.join(spec['runDir'], 'delivery.json'), result)
    write_json(os.path.join(jd, 'status.json'), result)


# ---------------------------------------------------------------- main

def main():
    if len(sys.argv) == 3 and sys.argv[1] == '_job':
        cmd_job(sys.argv[2])
        return

    ap = argparse.ArgumentParser(prog='dark-factory', description=__doc__.split('\n')[0])
    sub = ap.add_subparsers(dest='cmd', required=True)

    p = sub.add_parser('init')
    p.add_argument('--repo')
    p.add_argument('--seats', required=True)
    p.add_argument('--run-id')
    p.add_argument('--factory', action='store_true', help='capture delivery baseline and publish verification evidence')
    p.add_argument('--ref', action='append', help='a plan or other document the work follows; copied into <run>/refs/')
    p.add_argument('--started-at', help="the setup agent's own start time (ISO, from `date -u`); recorded as the timeline's setup-start")

    p = sub.add_parser('seat-run')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--vendor', default='codex', choices=['codex', 'gemini', 'claude'])
    p.add_argument('--seat', required=True, help='thread key; the vendor session is resumed per key')
    p.add_argument('--job', required=True)
    p.add_argument('--model', required=True)
    p.add_argument('--effort', default='high')
    p.add_argument('--sandbox', default='workspace-write', choices=['read-only', 'workspace-write'])
    p.add_argument('--cwd', required=True)
    p.add_argument('--writable', action='append')
    p.add_argument('--prompt-file', required=True)
    p.add_argument('--expect')
    p.add_argument('--no-transcript', action='store_true', help='read only --prompt-file; never recover a payload from Claude transcripts')
    p.add_argument('--transcript-wait', type=float, default=TRANSCRIPT_WAIT_SEC,
                   help='seconds to wait for the relay transcript to appear')
    p.add_argument('--fresh', action='store_true')
    p.add_argument('--resume-session', help='require this exact saved session; fail rather than start fresh (no transient retry)')
    p.add_argument('--timeout-min', type=int, default=90)
    p.add_argument('--max-wait', type=int, default=DEFAULT_MAX_WAIT)
    p.add_argument('--checkout', help='SEAT-LABEL: create --cwd as a checkout of that snapshot first, if it does not exist')

    p = sub.add_parser('wait')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--job', required=True)
    p.add_argument('--max-wait', type=int, default=DEFAULT_MAX_WAIT)
    p.add_argument('--brief', action='store_true', help='print a finished measurement as Pair reads it, without output tails')

    p = sub.add_parser('measure')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--seat', required=True)
    p.add_argument('--label', required=True)
    p.add_argument('--since', help='label of the previous snapshot; also writes <seat>.delta.diff')
    p.add_argument('--tests')
    p.add_argument('--replay-json', help='Pair accepted testRoots and current file/command mapping as JSON')
    p.add_argument('--path')
    p.add_argument('--no-snapshot', action='store_true')
    p.add_argument('--suite-timeout', type=int, default=1200)
    p.add_argument('--test-timeout', type=int, default=300)
    p.add_argument('--max-wait', type=int, default=DEFAULT_MAX_WAIT)
    p.add_argument('--brief', action='store_true', help='print the finished result as Pair reads it, without output tails')

    p = sub.add_parser('materialize')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--seat', required=True)
    p.add_argument('--label', required=True)
    p.add_argument('--name', help='directory name under snap/ (default SEAT-LABEL)')

    p = sub.add_parser('verify', help='run a gate in the named checkout using the shared verification settings')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--path', required=True)
    p.add_argument('--label', required=True, help='unique label for this gate run')
    p.add_argument('--command-file', help='focused or red-test command; defaults to the full verify.sh gate')
    p.add_argument('--suite-timeout', type=int, default=1200)
    p.add_argument('--max-wait', type=int, default=DEFAULT_MAX_WAIT)

    p = sub.add_parser('evidence', help='validate the published historical-evidence bundle for a snapshot')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--seat', required=True)
    p.add_argument('--label', required=True)

    p = sub.add_parser('verify-delivery', help='compare delivered bytes and rerun the gate in the main checkout')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--result', required=True, help='saved factory result JSON')
    p.add_argument('--manifest', help='JSON with adjustments and handoffs, each with path/reason/sha256')
    p.add_argument('--suite-timeout', type=int, default=1200)
    p.add_argument('--max-wait', type=int, default=DEFAULT_MAX_WAIT)
    p.add_argument('--diagnostic-reason', help='verify an incomplete run for diagnosis; records the reason without granting delivery readiness')

    p = sub.add_parser('apply', help='apply a ready reviewed snapshot to its base and verify the index tree hash')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--result', help='saved factory result JSON; defaults to RUN/result.json')

    p = sub.add_parser('usage')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--no-claude', action='store_true', help='skip the Claude agents\' token use (read from transcripts)')

    p = sub.add_parser('jobs')
    p.add_argument('--run-dir', required=True)

    p = sub.add_parser('preflight')
    p.add_argument('--vendors', required=True, help='comma-separated: codex, gemini, claude')

    p = sub.add_parser('cleanup')
    p.add_argument('--run-dir', required=True)
    p.add_argument('--all', action='store_true', help='also delete the room transcript')

    p = sub.add_parser('retro')
    p.add_argument('--run-dir')
    p.add_argument('--facts-only', action='store_true', help='save only the factory run facts from the payload (no retro.md)')
    p.add_argument('--summary', action='store_true', help='tally the saved factory facts by tier')
    p.add_argument('--expect', help='hash of the process notes and run facts in the retro agent\'s prompt')
    p.add_argument('--payload-file', help='read the process notes and facts from this file instead of Claude transcripts')
    p.add_argument('--out-dir', help=f'where retros are kept (default $COUNCIL_RETRO_DIR or {RETRO_DIR})')
    p.add_argument('--transcript-wait', type=float, default=TRANSCRIPT_WAIT_SEC,
                   help='seconds to wait for the retro agent\'s transcript to appear')

    p = sub.add_parser('hash')
    p.add_argument('--file', required=True)

    a = ap.parse_args()
    if getattr(a, 'run_dir', None):
        a.run_dir = os.path.abspath(os.path.expanduser(a.run_dir))
    handlers = {'init': cmd_init, 'seat-run': cmd_seat_run, 'wait': cmd_wait, 'measure': cmd_measure,
                'verify': cmd_verify, 'verify-delivery': cmd_verify_delivery, 'evidence': cmd_evidence,
                'apply': cmd_apply,
                'materialize': cmd_materialize, 'usage': cmd_usage, 'jobs': cmd_jobs,
                'cleanup': cmd_cleanup, 'retro': cmd_retro, 'hash': cmd_hash, 'preflight': cmd_preflight}
    try:
        pin_guard(getattr(a, 'run_dir', None), repo=getattr(a, 'repo', None))
        if a.cmd in TIMELINE_COMMANDS and a.cmd != 'init' and getattr(a, 'run_dir', None) and os.path.isdir(a.run_dir):
            timeline_event(a.run_dir, a.cmd, getattr(a, 'job', None))
        handlers[a.cmd](a)
    except (CouncilError, OSError, ValueError) as e:
        fail(str(e))


if __name__ == '__main__':
    main()
